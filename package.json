{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS — Real Estate Intelligence Operating System",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "js-yaml@^4.0.0": "^4.3.2",
      "fast-uri": "^3.1.6",
      "ajv@^8.0.0": "^8.20.0",
      "picomatch@^4.0.0": "^4.0.5",
      "glob@^10.0.0": "^10.5.0",
      "multer@^2.0.0": "^2.3.0",
      "lodash": "^4.18.0",
      "qs@^6.0.0": "^6.16.0",
      "body-parser@^1.0.0": "^1.20.6"
    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @atlas/api dev",
    "dev:web": "pnpm --filter @atlas/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @atlas/api prisma:generate",
    "prisma:migrate": "pnpm --filter @atlas/api prisma:migrate",
    "prisma:seed": "pnpm --filter @atlas/api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
