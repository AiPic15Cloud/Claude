# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public"

# ── Redis / BullMQ ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Meilisearch ─────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="atlas_dev_master_key"

# ── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Must differ from JWT_ACCESS_SECRET — signs the short-lived 2FA challenge
# token issued between password check and code verification, kept in a
# separate trust domain so it can never double as a real access token.
JWT_2FA_SECRET="change-me-2fa-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── API ─────────────────────────────────────────────────────
API_PORT=3001
API_CORS_ORIGIN="http://localhost:5173"

# ── Storage (local disk by default, S3-compatible when set) ─
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
S3_ENDPOINT=""
S3_REGION="eu-west-3"
S3_BUCKET="atlas-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ── AI providers ────────────────────────────────────────────
# Required to activate the Agents IA module (POST /agents/:key/chat).
# Without it, the endpoint returns a clear 503 rather than a fabricated reply.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# Reserved for future provider-routing (not yet wired to a module).
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ── Market data ─────────────────────────────────────────────
# Free-tier key from twelvedata.com — powers the CAC 40 ticker in the
# Topbar. Without it, the ticker just omits that item (no error).
TWELVE_DATA_API_KEY=""

# ── Web ─────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001/api/v1"
