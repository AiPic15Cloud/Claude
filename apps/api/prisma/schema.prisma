  updatedAt DateTime @updatedAt

  @@index([prequalificationCaseId])
  @@map("prequalification_companies")
}

enum PrequalAcquisitionStatus {
  OFFRE
  PROMESSE
  ACTE
  PROPRIETE
}

model PrequalProjectProfile {
  id                     String               @id @default(cuid())
  prequalificationCaseId String               @unique
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  address            String?
  cadastralRef       String?
  city               String?
  postcode           String?
  description        String?
  existingSurfaceSqm Decimal? @db.Decimal(10, 2)
  createdSurfaceSqm  Decimal? @db.Decimal(10, 2)
  soldSurfaceSqm     Decimal? @db.Decimal(10, 2)
  lotCount           Int?
  lotType            String?

  acquisitionStatus   PrequalAcquisitionStatus?
  conditionsPrecedent String[]                  @default([])
  acquisitionPrice    Decimal?                  @db.Decimal(14, 2)

  worksDescription   String?
  exitStrategy       String?
  interimRevenueNote String?
  targetTimeline     String?

  /// Section "Urbanisme" de la Trame Prequal — texte libre (statut du
  /// dossier d'urbanisme, servitudes, PLU...), jamais déduit d'autres champs.
  urbanismeNote String?
  /// Section "Commercialisation" de la Trame Prequal — appréciation qualitative
  /// (au-delà des statuts par lot déjà suivis dans PrequalSalesLot).
  commercialisationNote String?

  /// [{ label, note }] — ex. "acquisition préalable d'une parcelle communale".
  criticalDependencies Json[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

