// ATLAS — Real Estate Intelligence Operating System
// Prisma schema — foundation, Cockpit, Portefeuille, Dossiers, Score ATLAS,
// Knowledge Graph, Cartographie, Intelligence Concurrentielle and
// Intelligence Marché domain models. AI agents (module 9) read this data
// but do not require schema of their own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum DealType {
  PROMOTION_IMMOBILIERE
  DIVISION_PARCELLAIRE
  DIVISION_FONCIERE
  MISE_EN_COPROPRIETE
  AMENAGEMENT_FONCIER
  MARCHAND_DE_BIENS_AVEC_TRAVAUX
  MARCHAND_DE_BIENS_SANS_TRAVAUX
  REFINANCEMENT_FONDS_PROPRES
  REFINANCEMENT_ACTIF
  REFINANCEMENT_STOCK
}

/// Pipeline stage — drives the Kanban view in the Portefeuille module.
enum DealStage {
  SOURCING
  ANALYSE
  COMITE
  MONTAGE
  COLLECTE
  FINANCE
  SUIVI
  REMBOURSE
  DEFAUT
}

enum DealStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Typage de tâche (spec ATLAS v2, F.1) — pour le regroupement/filtrage
/// dans la vue Kanban transversale, distinct de la priorité (Priority).
enum TaskType {
  REPORTING
  FINANCE
  JURIDIQUE
  COMMERCIALISATION
  SUIVI_CIBLE
  AUTRE
}

enum CommitteeStatus {
  PAS_DE_COMITE
  VALIDE
  CONDITIONS_SUSPENSIVES
  REFUSE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ActivityType {
  DEAL_CREATED
  DEAL_UPDATED
  STAGE_CHANGED
  RECOVERY_STATUS_CHANGED
  NOTE_ADDED
  DOCUMENT_ADDED
  TASK_CREATED
  TASK_COMPLETED
  TAG_ADDED
  TAG_REMOVED
  GUARANTEE_ADDED
  GUARANTEE_VERIFIED
  FINANCIAL_MODEL_UPDATED
  ENTITY_LINKED
  CHECKPOINT_CREATED
  RISK_OVERRIDE_TRIGGERED
  ANALYST_OVERRIDE_SET
  STATUS_CHANGED
  PREQUALIFICATION_PROMOTED
}

enum GuaranteeType {
  HYPOTHEQUE
  FIDUCIE
  CAUTION
  GAGE
  NANTISSEMENT
  PRIVILEGE
  AUTRE
}

// "Situation juridique" du dossier — RAS → aucun signal ; Amiable → échéance
// dépassée sans réaction du porteur, encore en discussion ; Mise en demeure →
// courrier formel envoyé, pas encore d'action judiciaire ; Contentieux →
// action judiciaire engagée, avant toute procédure collective ; Procédure
// collective → la société du porteur est elle-même en procédure. Renseigné
// manuellement, aucune règle ne peut fiablement déduire ce jugement depuis
// les autres champs (mais alimente aussi bien le facteur EWS "recouvrement"
// que le hard override "procédure collective").
enum DealRecoveryStatus {
  RAS
  AMIABLE
  MISE_EN_DEMEURE
  CONTENTIEUX
  PROCEDURE_COLLECTIVE
}

/// MENSUEL : intérêts payés chaque mois (Deal.interestPaymentDay fixe le
/// jour d'échéance, suivi par InterestPayment + interest-payment-alerts.service.ts).
/// IN_FINE : capital et intérêts remboursés en une fois à l'échéance — aucun
/// suivi mensuel, interestPaymentDay reste sans effet.
enum DealRepaymentMode {
  MENSUEL
  IN_FINE
}

// Statut de surveillance ATLAS — dérivé du score composite, de l'EWS et de la
// vélocité (voir risk-engine/surveillance-status.util.ts), jamais saisi
// manuellement sauf override analyste explicite (DealOverride). CRITIQUE
// n'est jamais atteint par accumulation de points — seulement via un
// déclencheur dur (hard override : procédure collective, échéance en
// contentieux, garantie majeure expirée, chantier à l'arrêt).
enum DealSurveillanceStatus {
  FAIBLE
  SOUS_SURVEILLANCE
  ELEVE
  CRITIQUE
  /// Valeurs retirées du modèle par la migration
  /// 20260830195946_surveillance_status_4_paliers — Deal.surveillanceStatus
  /// (l'état live) a été migré vers les 4 valeurs ci-dessus à ce moment-là et
  /// se réauto-corrige à chaque recalcul, donc plus jamais produit ni relu en
  /// pratique. RiskScoreSnapshot est en revanche append-only ("jamais
  /// réécrit", même migration) : d'anciennes lignes d'historique portent
  /// encore ces deux valeurs. Sans elles ici, Prisma refuse de désérialiser
  /// ces lignes (`Value 'OUTPERFORMING' not found in enum...`), qui plantait
  /// RiskHistoryService à chaque nouveau snapshot sur un dossier ayant un
  /// historique antérieur à cette date. Ne jamais réutiliser ces valeurs dans
  /// du code applicatif nouveau — elles n'existent que pour pouvoir relire
  /// l'historique existant.
  OUTPERFORMING
  RECOVERY
}

// Réponse à une case ESG binaire "oui/non/inconnu" (D.3) — INCONNU est une
// réponse explicite ("évalué, résultat indéterminé"), distincte de null
// ("jamais renseigné") : les deux ne doivent jamais être confondues.
enum EsgAssessment {
  OUI
  NON
  INCONNU
}

enum GuaranteeStatus {
  ACTIVE
  RELEASED
  DEFAULTED
}

/// Knowledge Graph node types — every entity the graph connects together.
enum GraphEntityType {
  PROMOTEUR
  BANQUE
  NOTAIRE
  ARCHITECTE
  COLLECTIVITE
  INVESTISSEUR
  PLATEFORME
}

/// The role a Knowledge Graph entity plays on a specific deal.
enum DealEntityRole {
  PROMOTEUR
  BANQUE_FINANCEUR
  NOTAIRE
  ARCHITECTE
  COLLECTIVITE
  INVESTISSEUR
  GARANT
  AUTRE
}

enum GraphRelationType {
  PARTENAIRE
  FINANCEUR
  CONSEIL
  CONCURRENT
  AUTRE
}

enum ArticleCategory {
  TAUX
  INFLATION
  CONSTRUCTION
  IMMOBILIER
  LOGISTIQUE
  COMMERCE
  RESIDENTIEL
  REGLEMENTATION
  CONCURRENCE
  AUTRE
}

// ── Core tenancy ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  deals                  Deal[]
  tags                   Tag[]
  alerts                 Alert[]
  graphEntities          GraphEntity[]
  graphRelations         GraphRelation[]
  newsSources            NewsSource[]
  articles               Article[]
  feesTargets            FeesTarget[]
  pipelineEntries        PipelineEntry[]
  competitorProjects     CompetitorProject[]
  tasks                  Task[]
  fieldChanges           FieldChange[]
  dataValidations        DataValidation[]
  riskScoreSnapshots     RiskScoreSnapshot[]
  riskOverrides          RiskOverride[]
  dealOverrides          DealOverride[]
  entities               Entity[]
  relationships          Relationship[]
  playbookInstances      PlaybookInstance[]
  economicGroups         EconomicGroup[]
  legalEvents            LegalEvent[]
  financialEvents        FinancialEvent[]
  contagionSignals       ContagionSignal[]
  fractionalProjects     FractionalProject[]
  platformProfiles       PlatformFractionalProfile[]
  rentIndexSeries        RentIndexSeries[]
  marketComparables      MarketComparablePool[]
  scoreCategories        FractionalScoreCategory[]
  eliminatoryRules       FractionalEliminatoryRule[]
  observationEntityLinks ProjectObservationEntityLink[]
  prequalificationCases  PrequalificationCase[]

  @@map("organizations")
}

// One row per year — the "objectif annuel" the Cockpit fees chart is
// measured against.
model FeesTarget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year         Int
  targetAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year])
  @@map("fees_targets")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(ANALYST)
  avatarUrl      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  createdDeals                    Deal[]                         @relation("DealCreatedBy")
  assignedDeals                   Deal[]                         @relation("DealAssignedTo")
  notes                           Note[]
  documents                       Document[]
  repayments                      Repayment[]
  interestPayments                InterestPayment[]
  loanExtensions                  LoanExtension[]
  pipelineEntries                 PipelineEntry[]
  tasksAssigned                   Task[]                         @relation("TaskAssignee")
  tasksCreated                    Task[]                         @relation("TaskCreatedBy")
  tasksCancelled                  Task[]                         @relation("TaskCancelledBy")
  activities                      Activity[]
  refreshTokens                   RefreshToken[]
  competitorProjectsLogged        CompetitorProject[]
  projectCheckpointsRecorded      ProjectCheckpoint[]
  agentMessages                   AgentMessage[]
  pushSubscriptions               PushSubscription[]
  fieldChanges                    FieldChange[]
  dataValidations                 DataValidation[]
  financialAssumptionsLocked      FinancialAssumption[]
  dealOverridesCreated            DealOverride[]                 @relation("DealOverrideCreatedBy")
  dealOverridesCleared            DealOverride[]                 @relation("DealOverrideClearedBy")
  relationshipEvidence            Evidence[]
  fractionalProjectsCreated       FractionalProject[]
  observationEntityLinksReviewed  ProjectObservationEntityLink[]
  prequalCasesAssigned            PrequalificationCase[]         @relation("PrequalAssignedAnalyst")
  prequalCasesCreated             PrequalificationCase[]         @relation("PrequalCreatedBy")
  prequalCasesValidated           PrequalificationCase[]         @relation("PrequalValidatedBy")
  prequalVersionsValidated        PrequalificationVersion[]
  prequalDocumentsUploaded        PrequalDocument[]
  prequalEvidenceVerified         PrequalEvidence[]
  prequalFindingsReviewed         Finding[]
  prequalFinancialBaselinesLocked PrequalFinancialModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

/// One row per browser/device that opted into push notifications — a user
/// can have several (phone, laptop). Deleted on unsubscribe, or pruned by
/// PushService when the push endpoint reports it's gone (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Portfolio domain ───────────────────────────────────────

// Backs atomic reference-number generation (ATL-YYYY-NNNN). A read-then-
// increment in application code races under concurrent creates — two
// requests can read the same "last" value before either commits, then
// both retry from that same stale reading. A single atomic SQL upsert
// against this counter closes that race entirely, regardless of load.
model ReferenceCounter {
  organizationId String
  year           Int
  value          Int

  @@id([organizationId, year])
  @@map("reference_counters")
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference   String     @unique
  name        String
  type        DealType
  stage       DealStage  @default(SOURCING)
  status      DealStatus @default(ACTIVE)
  description String?

  // Financials
  amountTarget   Decimal  @db.Decimal(14, 2)
  amountRaised   Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("EUR")
  interestRate   Decimal? @db.Decimal(5, 2)
  durationMonths Int?

  /// Mode de remboursement (mensuel vs in fine) — null = non renseigné,
  /// jamais présumé mensuel par défaut. interestPaymentDay (1-31, ajusté au
  /// dernier jour du mois si le mois est plus court) ne s'applique qu'en
  /// MENSUEL et pilote interest-payment-alerts.service.ts.
  repaymentMode      DealRepaymentMode?
  interestPaymentDay Int?

  // Fees — feesRate is the input (%), feesAmount is always server-derived
  // from feesRate × amountRaised, never accepted directly from a client.
  feesRate   Decimal? @db.Decimal(5, 2)
  feesAmount Decimal  @default(0) @db.Decimal(14, 2)

  // Location
  address  String?
  city     String?
  postcode String?
  country  String   @default("FR")
  lat      Decimal? @db.Decimal(9, 6)
  lng      Decimal? @db.Decimal(9, 6)

  // Risk Engine — score de risque dynamique (0 = aucun risque, 100 = risque
  // maximal), recalculé à chaque événement pertinent (checkpoint, garantie,
  // recouvrement, échéance, surveillance société) plutôt que sur un simple
  // timer. riskScorePrevious ne garde que la valeur d'avant le dernier
  // recalcul (pas un historique complet) — suffisant pour la flèche de
  // tendance par dossier, mais ne peut pas honnêtement porter un delta
  // "cette semaine" au niveau portefeuille une fois les recalculs
  // événementiels multiples par jour ; une vraie table de snapshots
  // horodatés serait nécessaire pour ça, en suivi séparé si besoin.
  riskScore          Int?
  riskScorePrevious  Int?
  riskScoreUpdatedAt DateTime?

  // Dernier score connu juste avant la clôture du dossier (repaid ou
  // DEFAUT) — capturé une seule fois, jamais réécrit ensuite. Sert de base
  // 100% réelle à la validation rétrospective du modèle (RiskEngineService
  // .getModelValidation()) : rapprocher ce score du résultat effectif
  // (remboursé vs défaut) plutôt que de calibrer les pondérations sans
  // historique suffisant.
  riskScoreAtClosure     Int?
  riskScoreAtClosureDate DateTime?

  // Risk Engine v2 (Phase 1) — trois scores indépendants qui alimentent le
  // score composite ci-dessus (riskScore) plutôt que de le remplacer :
  // qualité structurelle (stable), exécution réelle vs BP (dynamique), et
  // signaux d'alerte précoce (le plus réactif). Voir risk-engine/*.util.ts.
  qualityScore     Int?
  performanceScore Int?
  ewsScore         Int?

  surveillanceStatus DealSurveillanceStatus?

  // Réponse Phase 1 (délibérément manuelle) au "chantier abandonné" du
  // brief — aucune donnée existante ne permet de le déduire de façon fiable
  // sans risque de faux négatif ; un hard override le plafonne à CRITIQUE.
  chantierSignaleArret   Boolean   @default(false)
  chantierSignaleArretAt DateTime?

  startDate DateTime?
  endDate   DateTime?

  // Deadline tracking (échéance de vote) — dateMax drives the J-90/J-60/J-30/J-15
  // escalation process; dateMin/dateCible are informational targets either
  // side of it.
  dateMin   DateTime?
  dateCible DateTime?
  dateMax   DateTime?

  // Frise du cycle de vie du prêt (spec ATLAS v2, A.3bis) — dateEcheanceInitiale
  // est posée une seule fois (à la création, ou rétroactivement à la valeur de
  // dateMax lors de la toute première prorogation formelle) et n'est plus
  // jamais réécrite ensuite, y compris par une prorogation : la frise doit
  // toujours pouvoir mesurer l'écart réel par rapport à l'engagement contractuel
  // d'origine. dateMax reste l'échéance courante (= dateEcheanceInitiale, ou la
  // dernière prorogation de loanExtensions) et continue d'alimenter tel quel
  // tout le reste de l'app (deadline-alerts, mise en demeure, cockpit).
  dateEcheanceInitiale DateTime?

  // repaid suppresses deadline-alert escalation entirely (a fully repaid
  // deal shouldn't keep raising "échéance dépassée" once it's settled).
  // recoveryStatus is an independent manual field — a deal can be repaid or
  // active while also being flagged as in (pre-)litigation.
  repaid         Boolean            @default(false)
  recoveryStatus DealRecoveryStatus @default(RAS)

  // Déclencheur "Perte" du dashboard portefeuille agrégé (spec ATLAS v2,
  // module MARKO F.2) — délibérément manuel, comme chantierSignaleArret
  // ci-dessus : "liquidation judiciaire prononcée + délai de recouvrement
  // épuisé" reste un jugement de l'analyste (quel délai ? quelle preuve
  // d'épuisement ?), pas une règle automatisable sans risque de faux
  // positif/négatif sur un critère juridique. Distinct de `recoveryStatus`
  // (procédure en cours) : ceci acte une perte définitive, pas un simple
  // statut de recouvrement.
  perteDefinitiveActee Boolean   @default(false)
  perteDefinitiveNote  String?
  perteDefinitiveDate  DateTime?

  // Investor newsletter follow-up — lastNewsletterDate resets the countdown;
  // status (À jour / À relancer / Critique) is derived from the elapsed days
  // vs. newsletterTargetDays, not stored.
  lastNewsletterDate   DateTime?
  newsletterTargetDays Int       @default(45)

  // Porteur de projet (recipient of relance/mise en demeure correspondence)
  // — distinct from the property's own address above, which is the asset's
  // location, not the operator's contact details.
  porteurNom     String?
  porteurSociete String?
  porteurAdresse String?

  // Surveillance de la société de projet — SIREN suivi quotidiennement via
  // l'API Recherche d'Entreprises (data.gouv.fr) pour détecter une procédure
  // collective ou une cessation d'activité. porteurMonitoringStatus est le
  // dernier statut connu ('actif' / 'procedure_collective' / 'fermee'),
  // comparé à chaque vérification pour n'alerter que sur un vrai changement
  // plutôt qu'à chaque exécution du job.
  porteurSiren            String?
  porteurMonitoringStatus String?

  // Fraîcheur des données externes (section 6 du brief "Le Traçotin") : date
  // du dernier appel réussi à chaque source, indépendamment du fait que le
  // résultat ait changé — alimente le score de confiance du dossier
  // (data-freshness.util.ts). porteurCheckedAt couvre SIRENE+BODACC (toujours
  // interrogées ensemble par CompanyMonitoringService.fetchStatus()),
  // riskDataCheckedAt couvre Géorisques/IGN/Overpass (toujours interrogés
  // ensemble par RiskDataService.getRiskProfile()), dpeCheckedAt couvre ADEME.
  porteurCheckedAt  DateTime?
  riskDataCheckedAt DateTime?
  dpeCheckedAt      DateTime?

  // Dimension ESG (spec complémentaire ATLAS "modules d'entraînement analyste
  // investissement", D.3) — volontairement simple, à visée de familiarisation
  // au vocabulaire ESG plutôt qu'un scoring normé (taxonomie européenne/SFDR).
  // Champs strictement additifs et informatifs : aucun impact sur le score de
  // risque (A.2) ni sur aucun calcul existant. La performance énergétique
  // (DPE, via ADEME) et la transparence du porteur (SIREN/monitoring
  // ci-dessus) ne sont pas dupliquées ici — déjà disponibles par ailleurs.
  esgMateriauxBasCarbone     EsgAssessment?
  esgGestionEauxPluviales    String?
  esgEmploisChantierEstimes  Int?
  esgAccessibilite           String?
  esgConformiteReglementaire EsgAssessment?
  esgNotes                   String?

  createdById  String
  createdBy    User    @relation("DealCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("DealAssignedTo", fields: [assignedToId], references: [id])

  tags                         DealTag[]
  notes                        Note[]
  documents                    Document[]
  tasks                        Task[]
  activities                   Activity[]
  alerts                       Alert[]
  guarantees                   Guarantee[]
  costLineItems                CostLineItem[]
  saleLots                     SaleLot[]
  financialAssumption          FinancialAssumption?
  entityLinks                  DealEntityLink[]
  repayments                   Repayment[]
  interestPayments             InterestPayment[]
  loanExtensions               LoanExtension[]
  convertedFromPipelineEntry   PipelineEntry?        @relation("PipelineConvertedDeal")
  checkpoints                  ProjectCheckpoint[]
  agentMessages                AgentMessage[]
  fieldChanges                 FieldChange[]
  dataValidations              DataValidation[]
  riskScoreSnapshots           RiskScoreSnapshot[]
  riskOverrides                RiskOverride[]
  dealOverrides                DealOverride[]
  /// Entité miroir dans le Knowledge Graph (type OPERATION) — voir Entity.mirrorsDealId.
  entityMirror                 Entity?
  playbookInstances            PlaybookInstance[]
  contagionSignals             ContagionSignal[]
  milestones                   PortfolioMilestone[]
  /// Back-relation de PrequalificationCase.promotedDeal — un Deal promu
  /// depuis une préqualification pointe vers elle, jamais l'inverse dans
  /// l'autre sens (une préqualification WAIT/NO_GO n'a jamais de Deal).
  promotedFromPrequalification PrequalificationCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([stage])
  @@index([type])
  @@index([status])
  @@map("deals")
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#6366f1")

  deals DealTag[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@map("tags")
}

model DealTag {
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

// A sourcing-stage entry — a deal file received and reviewed, before (or
// instead of) becoming an actual Deal. Distinct from Deal because most
// entries here are rejected and never enter the managed portfolio.
model PipelineEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date      DateTime
  operator  String
  typology  String?
  source    String?
  amount    Decimal         @db.Decimal(14, 2)
  margin    Decimal?        @db.Decimal(5, 2)
  // ATLAS's own fee rate (%) negotiated on this dossier — distinct from
  // `margin`, which is the underlying deal's profitability. Feeds the fees
  // projection (below) per-dossier instead of falling back to the
  // portfolio-wide average feesRate for every pipeline entry alike.
  feesRate  Decimal?        @db.Decimal(5, 2)
  committee CommitteeStatus @default(PAS_DE_COMITE)
  decision  String?

  // Set once this dossier has actually been turned into a live operation —
  // the one-way link that lets the pipeline's conversion KPIs (and the fees
  // projection) be grounded in real portfolio deals instead of guesswork.
  convertedDealId String? @unique
  convertedDeal   Deal?   @relation("PipelineConvertedDeal", fields: [convertedDealId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([committee])
  @@map("pipeline_entries")
}

// A repayment made to investors on a deal — either already paid (projected:
// false) or a forward-looking estimate (projected: true) used for the
// Cockpit's repayment forecast.
model Repayment {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  projected Boolean  @default(false)
  note      String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("repayments")
}

// Paiement d'intérêts effectivement constaté (mode MENSUEL, cf.
// Deal.repaymentMode/interestPaymentDay) — distinct de Repayment
// (remboursements de capital, non rattachés à une échéance récurrente) :
// chaque ligne ici est comparée au jour d'échéance du mois pour détecter un
// retard (interest-payment.util.ts + interest-payment-alerts.service.ts).
// amount optionnel : l'analyste peut d'abord constater "payé le [date]"
// sans ressaisir le montant si celui-ci est déjà connu par ailleurs.
model InterestPayment {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  paidDate DateTime
  amount   Decimal? @db.Decimal(14, 2)
  note     String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("interest_payments")
}

// Une prorogation formelle de l'échéance du prêt (spec ATLAS v2, A.3bis) —
// distincte d'une simple correction de dateMax via le PATCH générique du
// deal : chaque entrée ici a sa propre date de signature (potentiellement
// différente de la date de saisie) et sa nouvelle échéance, conservées dans
// l'ordre pour reconstruire la frise (segments "hors contrat"/"prorogé").
// Jamais mutée ni supprimée après création — c'est un historique, pas un état.
model LoanExtension {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  dateSignature        DateTime
  nouvelleDateEcheance DateTime

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("loan_extensions")
}

model Note {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId String
  author   User        @relation(fields: [authorId], references: [id])
  content  String
  images   NoteImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("notes")
}

model NoteImage {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  mimeType      String
  storageKey    String
  storageDriver String @default("local")

  createdAt DateTime @default(now())

  @@index([noteId])
  @@map("note_images")
}

// État des lieux fait à la durée cible (et éventuellement au-delà, si le
// dossier reste sous surveillance rapprochée) — un chargé d'affaires
// enregistre un point à la fois, jamais modifié après coup, pour garder
// l'historique des points successifs sur un même dossier plutôt qu'un
// unique état toujours écrasé.
model ProjectCheckpoint {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  travauxBudgetInitial Decimal? @db.Decimal(14, 2)
  travauxDepensesADate Decimal? @db.Decimal(14, 2)
  travauxTermines      Boolean  @default(false)

  commercialisationLancee Boolean  @default(false)
  pourcentageVendu        Int?
  prixVenteInitialPrevu   Decimal? @db.Decimal(14, 2)
  // Objectif de prix revu par le porteur de projet (ex. baisse pour accélérer la
  // commercialisation) — distinct de prixVenteReelADate qui reste les ventes
  // effectivement réalisées à ce jour, potentiellement en deçà de cet objectif.
  prixVenteActualise      Decimal? @db.Decimal(14, 2)
  prixVenteReelADate      Decimal? @db.Decimal(14, 2)

  atterrissagePrevu String?
  notes             String?

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("project_checkpoints")
}

// One row per turn of an Assistant IA conversation on a deal — including the
// Devil's Advocate replies (agentKey "devil"), so both the agents' analyses
// and the contradictory review survive navigation/reload instead of living
// only in the browser tab's React state, and keep feeding the dossier's
// analysis over time instead of being re-derived from scratch each session.
model AgentMessage {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Which agent persona produced (or received, for a user turn) this
  /// message — e.g. "analyst", "legal", "devil".
  agentKey String
  role     String
  content  String @db.Text

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("agent_messages")
}

model Document {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  name          String
  mimeType      String
  size          Int
  storageKey    String
  storageDriver String @default("local")

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fieldChanges FieldChange[]

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("documents")
}

// Journal d'audit générique par champ — distinct d'Activity (fil narratif
// lisible) : ici, chaque ligne est une valeur structurée avant/après,
// interrogeable par champ, pour la gouvernance de la donnée (qui a changé
// quoi, quand, et avec quel document à l'appui). entityType est une chaîne
// libre plutôt qu'un enum pour ne pas exiger de migration à chaque nouvelle
// surface auditée (aujourd'hui : 'Deal', 'FinancialAssumption').
model FieldChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  entityType String
  fieldKey   String
  fieldLabel String

  /// Stringifié pour affichage ; null = première valeur jamais renseignée.
  oldValue String?
  newValue String?

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  sourceDocumentId String?
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  @@index([organizationId])
  @@index([dealId, entityType])
  @@map("field_changes")
}

// Sign-off d'une seule personne (pas un maker-checker à deux) : atteste que
// l'état actuel d'une entité sur ce dossier a été relu et confirmé, avec
// horodatage. Une ligne = "validé, rien n'a changé depuis" — dès qu'un
// nouveau FieldChange est écrit pour ce (dealId, entityType), la ligne est
// supprimée (FieldChangeService.recordDiff) pour que "validé" ne mente
// jamais sur l'état réel.
model DataValidation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  entityType String // même convention que FieldChange.entityType

  validatedById String
  validatedBy   User     @relation(fields: [validatedById], references: [id], onDelete: Cascade)
  validatedAt   DateTime @default(now())

  @@unique([dealId, entityType])
  @@map("data_validations")
}

/// Historique append-only de chaque recalcul de risque qui CHANGE le tuple de
/// scores (voir risk-history.service.ts, condition d'écriture) — jamais
/// écrasé, contrairement à Deal.riskScore/qualityScore/etc qui ne gardent que
/// la dernière valeur connue. Alimente Δ7j/Δ30j/Δ90j, le graphique de
/// trajectoire, et l'explicabilité (breakdown JSON = détail complet du calcul
/// à cet instant, permet de comparer deux points dans le temps sans tout
/// recalculer).
model RiskScoreSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Nullable depuis le passage au score additif unique (v3.0) : ces 3
  /// sous-scores n'existent plus conceptuellement, seul compositeScore reste
  /// renseigné pour les nouvelles lignes. L'historique v2.1 garde ses
  /// valeurs intactes — jamais réécrit rétroactivement (voir modelVersion).
  qualityScore       Int?
  performanceScore   Int?
  ewsScore           Int?
  compositeScore     Int
  surveillanceStatus DealSurveillanceStatus

  breakdown Json
  trigger   String

  /// Identifie la version des poids/seuils du Risk Engine qui a produit cette
  /// ligne — sans ça, un changement futur de formule (Phase 2+) rendrait
  /// l'historique ambigu sur quel modèle a calculé quel score.
  modelVersion String @default("risk-engine-v2.1")

  computedAt DateTime @default(now())

  @@index([dealId, computedAt])
  @@index([organizationId])
  @@map("risk_score_snapshots")
}

/// Hard override objectif, piloté par règle (voir hard-override-rules.ts) —
/// s'ouvre et se résout automatiquement à chaque recalcul selon que la
/// condition déclenchante reste vraie ou non. Impose un plancher minimum sur
/// le statut de surveillance qu'aucun bon score ne peut compenser
/// mathématiquement. Distinct de DealOverride (jugement humain).
model RiskOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  ruleKey                   String
  /// Texte de la règle figé au déclenchement — reste lisible et stable même
  /// si le libellé de la règle change plus tard dans le code.
  label                     String
  minimumSurveillanceStatus DealSurveillanceStatus

  active      Boolean   @default(true)
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([dealId, active])
  @@index([organizationId])
  @@map("risk_overrides")
}

/// Override analyste du statut de surveillance CALCULÉ — un jugement humain
/// explicite, distinct de RiskOverride (règle objective) et de DataValidation
/// (simple attestation que rien n'a changé). Reste actif tant qu'il n'est pas
/// explicitement levé — le moteur automatique ne l'écrase jamais en silence.
model DealOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  automaticStatus DealSurveillanceStatus
  overrideStatus  DealSurveillanceStatus
  justification   String

  createdById String
  createdBy   User     @relation("DealOverrideCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  active      Boolean   @default(true)
  clearedAt   DateTime?
  clearedById String?
  clearedBy   User?     @relation("DealOverrideClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)

  @@index([dealId, active])
  @@index([organizationId])
  @@map("deal_overrides")
}

model Task {
  id     String  @id @default(cuid())
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Set directly at creation (not derived from `deal`) so deal-less tasks
  /// still carry a real tenant boundary — every query filters on this
  /// column, never on "no deal means no scope" fallbacks.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title    String
  done     Boolean   @default(false)
  priority Priority  @default(MEDIUM)
  dueDate  DateTime?

  /// Typage de tâche (spec ATLAS v2, F.1) — attribué par défaut par le
  /// moteur de règles/playbooks selon la nature de la tâche générée,
  /// modifiable par l'analyste pour les tâches manuelles.
  typeTache TaskType @default(AUTRE)

  /// Deuxième champ ajouté par rapport à l'estimation initiale de la spec
  /// F.1 ("ajout d'un seul champ") : le modèle existant n'avait qu'un
  /// booléen `done`, pas de distinction "à faire" / "en cours" — nécessaire
  /// pour un vrai Kanban à 3 colonnes plutôt qu'un état "en cours" fictif
  /// déduit d'une heuristique (ex. échéance proche) qui ne refléterait rien
  /// de réel. Purement manuel (l'analyste bascule une tâche qu'il a
  /// commencée) ; `done` reste la seule source de vérité pour "Terminé".
  inProgress Boolean @default(false)

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  /// Spec ATLAS v2, A.10 — annulation = transition de statut, jamais une suppression de ligne : une action générée (par un analyste ou par un playbook) doit rester traçable a posteriori. `remove()` renseigne ces deux champs au lieu d'un DELETE ; les listes par défaut filtrent `cancelledAt: null`.
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("TaskCancelledBy", fields: [cancelledById], references: [id])

  /// Présente uniquement si cette tâche a été générée par un playbook (A.4) — le statut affiché à l'analyste reste `done`/`dueDate` ci-dessus, jamais un champ dupliqué côté playbook.
  playbookActionItem PlaybookActionItem?
  alerts             Alert[]

  @@index([dealId])
  @@index([organizationId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Activity {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    ActivityType
  message String

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("activities")
}

model Alert {
  id                        String                   @id @default(cuid())
  organizationId            String
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId                    String?
  deal                      Deal?                    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  articleId                 String?
  article                   Article?                 @relation(fields: [articleId], references: [id], onDelete: SetNull)
  fractionalProjectId       String?
  fractionalProject         FractionalProject?       @relation(fields: [fractionalProjectId], references: [id], onDelete: Cascade)
  projectObservationEventId String?
  projectObservationEvent   ProjectObservationEvent? @relation(fields: [projectObservationEventId], references: [id], onDelete: SetNull)
  /// Tâche à l'origine de l'alerte (tâche urgente en retard, action de
  /// playbook bloquante en retard — cette dernière est elle-même adossée à
  /// un Task via PlaybookActionItem.taskId). Sert de clé de déduplication
  /// stable : sans elle, un dédoublonnage par simple titre laisse une alerte
  /// résolue bloquer silencieusement toute nouvelle alerte si la même tâche
  /// redevient en retard plus tard (ou si deux tâches distinctes partagent
  /// le même titre).
  taskId                    String?
  task                      Task?                    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  severity AlertSeverity @default(INFO)
  title    String
  message  String
  read     Boolean       @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([read])
  @@index([taskId])
  @@map("alerts")
}

// ── Dossiers: guarantees & financial model ────────────────

model Guarantee {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type        GuaranteeType
  description String
  amount      Decimal         @db.Decimal(14, 2)
  rank        Int             @default(1)
  status      GuaranteeStatus @default(ACTIVE)

  // Applies to HYPOTHEQUE / FIDUCIE / CAUTION — other guarantee types don't
  // carry a renewal deadline. Drives both the "Valide / Non valide" state
  // (computed, not stored — see guarantee-expiry.util.ts) and the 6-month
  // renewal warning/notification.
  endDate DateTime?

  /// Dernière vérification par un analyste (spec ATLAS v2, A.5 —
  /// "statut de chaque sûreté vérifié dans les 30 derniers jours ?").
  /// Distinct d'endDate : une sûreté peut être valide sur le papier mais
  /// jamais recontrôlée récemment.
  verifiedAt DateTime?

  /// Vice de fond (spec ATLAS v2, A.9) — mauvais rang enregistré, signature
  /// manquante, vice de forme... jamais déductible d'une donnée existante,
  /// un analyste doit le constater explicitement (note obligatoire). Rend
  /// la sûreté NON_VALIDE même si endDate est encore dans le futur — voir
  /// guarantee-expiry.util.ts.
  substantiveDefect     Boolean @default(false)
  substantiveDefectNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("guarantees")
}

/// Inputs for the deal's financial model. Sensitivity scenarios (± on
/// selling price and construction cost) are computed on the fly from these
/// assumptions rather than stored, so they always reflect the latest input.
// Modèle financier v2 (Phase 1) — reconstruit à partir du classeur d'audit
// réel de l'utilisateur (Foncier / Travaux / Honoraires techniques / Autres
// frais / Financement LPB / Financement bancaire), plutôt que le triptyque
// surface×coût/m²×prix/m² d'origine. Les postes "Travaux" sont libres (voir
// CostLineItem) — confirmé par l'utilisateur, pas des champs fixes.
model FinancialAssumption {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  surfaceSqm         Decimal  @db.Decimal(10, 2)
  sellingPricePerSqm Decimal  @db.Decimal(10, 2)
  targetMarginPct    Decimal? @db.Decimal(5, 2)
  notes              String?

  // Covenants ICR/DSCR (spec ATLAS v2, module MARKO F.3) — saisie manuelle
  // uniquement : aucune collecte automatique de résultat opérationnel ou de
  // trésorerie n'existe dans ATLAS, et la spec elle-même réserve la
  // pertinence de ces deux ratios pour du marchand de biens à cycle court
  // sans revenu d'exploitation récurrent pendant la détention. LTV n'a pas
  // besoin de champ dédié : il se déduit de CRD + surfaceSqm×sellingPricePerSqm
  // ci-dessus (cf. covenant.util.ts).
  resultatOperationnelEstime     Decimal? @db.Decimal(14, 2)
  fluxTresorerieDisponibleEstime Decimal? @db.Decimal(14, 2)

  // Foncier
  landPrice  Decimal? @db.Decimal(14, 2)
  notaryFees Decimal? @db.Decimal(14, 2)

  // Honoraires techniques — structure fixe (confirmée telle quelle dans le classeur d'audit)
  diagnosticsCost   Decimal? @db.Decimal(14, 2)
  insuranceCost     Decimal? @db.Decimal(14, 2)
  propertyTaxCost   Decimal? @db.Decimal(14, 2)
  surveyStudiesCost Decimal? @db.Decimal(14, 2)

  // Autres frais — les frais LPB (garantie/intérêts/fees) sont calculés, jamais saisis ici.
  // agencyFees et referralFees sont deux commissions distinctes (agence immobilière vs
  // apporteur d'affaires) — toutes deux à 0 par défaut si aucun frais.
  agencyFees   Decimal? @db.Decimal(14, 2)
  referralFees Decimal? @db.Decimal(14, 2)
  bankMiscFees Decimal? @db.Decimal(14, 2)

  // Financement LPB — la collecte/le taux/la durée cible réutilisent
  // Deal.amountTarget/interestRate/durationMonths, pas de doublon de saisie.
  lpbFeesPctHT         Decimal? @db.Decimal(5, 2)
  lpbTvaApplicable     Boolean  @default(false)
  lpbTvaRatePct        Decimal? @db.Decimal(5, 2)
  lpbDurationMinMonths Int?
  lpbDurationMaxMonths Int?
  // Simulation "et si le projet est en retard" : +5 points sur le taux LPB
  // utilisé pour calculer les intérêts sur durée cible — sert à mesurer
  // l'impact financier réel d'un dépassement plutôt qu'à documenter un fait.
  latePenaltyApplied   Boolean  @default(false)

  // Financement bancaire (optionnel, distinct de LPB) — activé dès qu'un nom de banque est renseigné
  bankName               String?
  bankLoanAcquisition    Decimal? @db.Decimal(14, 2)
  bankLoanAccompagnement Decimal? @db.Decimal(14, 2)
  bankInterestRatePct    Decimal? @db.Decimal(5, 2)
  bankFileFees           Decimal? @db.Decimal(14, 2)
  bankGuaranteeFees      Decimal? @db.Decimal(14, 2)

  // BP initial figé — copie gelée des totaux calculés (Foncier, Travaux,
  // Honoraires, financement, marge, sensibilité) au moment où l'utilisateur
  // clique "Figer le BP initial", une fois sa saisie terminée. Tant que
  // baselineLockedAt est null, aucune comparaison initial/actualisé n'est
  // affichée — évite qu'un champ encore vide en cours de saisie (donc à sa
  // valeur par défaut) soit pris à tort pour le "point de départ" réel.
  baselineSnapshot   Json?
  baselineLockedAt   DateTime?
  baselineLockedById String?
  baselineLockedBy   User?     @relation(fields: [baselineLockedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("financial_assumptions")
}

// Postes de coût libres — aujourd'hui uniquement les "Travaux" (l'utilisateur
// les saisit ligne par ligne dans son classeur réel, pas via des champs
// fixes). `category` prévoit l'extension à d'autres postes plus tard, non
// exploitée pour l'instant.
model CostLineItem {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  category  String
  label     String
  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, category])
  @@map("cost_line_items")
}

/// Grille de commercialisation lot par lot — remplace le prix de vente moyen
/// (sellingPricePerSqm × surfaceSqm) par la somme des prix réels/prévisionnels
/// de chaque lot dès qu'au moins un lot est saisi (FinancialModelService).
/// Un prix moyen peut masquer qu'un projet n'est viable que si certains lots
/// se vendent au-dessus du marché — la grille rend ce risque visible.
model SaleLot {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  label      String
  surfaceSqm Decimal @db.Decimal(10, 2)
  salePrice  Decimal @db.Decimal(14, 2)
  // Statut de commercialisation du lot — string libre (pas un enum Prisma)
  // pour rester cohérent avec CostLineItem.category : validé côté DTO
  // (@IsIn), pas de migration nécessaire si un statut s'ajoute plus tard.
  // Valeurs : EN_VENTE | OFFRE | PROMESSE_COMPROMIS | RESERVATION | VENDU
  status     String  @default("EN_VENTE")
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("sale_lots")
}

// ── Knowledge Graph ────────────────────────────────────────

/// A node in the Knowledge Graph: promoteur, banque, notaire, architecte,
/// collectivité, investisseur or plateforme. Type-specific attributes
/// (e.g. a platform's category or founding year) live in `metadata`.
model GraphEntity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        GraphEntityType
  name        String
  description String?
  website     String?
  city        String?
  /// City-centroid coordinates (not street-level) — used by the Cartographie module.
  lat         Decimal?        @db.Decimal(9, 6)
  lng         Decimal?        @db.Decimal(9, 6)
  metadata    Json?

  /// Person to contact at this entity (e.g. the porteur de projet themselves,
  /// or the relationship manager at a bank/notaire) — distinct from `name`,
  /// which is the organization/company name.
  contactName String?
  email       String?
  phone       String?

  /// SIREN du porteur (pertinent surtout pour type=PROMOTEUR) — permet de
  /// rapprocher automatiquement cette entité du champ texte libre
  /// Deal.porteurSiren (voir DealsService/GraphService.autoLinkPromoteurBySiren).
  siren String?

  dealLinks               DealEntityLink[]
  relationsFrom           GraphRelation[]          @relation("RelationFrom")
  relationsTo             GraphRelation[]          @relation("RelationTo")
  articles                ArticleEntityLink[]
  competitorProjects      CompetitorProject[]
  competitorProjectEvents CompetitorProjectEvent[]
  platformStatsSnapshots  PlatformStatsSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, siren])
  @@index([organizationId])
  @@index([type])
  @@map("graph_entities")
}

/// Links a deal to a Knowledge Graph entity with a specific role
/// (e.g. this deal's promoteur, or its notaire).
model DealEntityLink {
  id       String         @id @default(cuid())
  dealId   String
  deal     Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  entityId String
  entity   GraphEntity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role     DealEntityRole

  createdAt DateTime @default(now())

  @@unique([dealId, entityId, role])
  @@index([entityId])
  @@map("deal_entity_links")
}

/// An edge between two Knowledge Graph entities (e.g. a promoteur partnered
/// with a bank, or two platforms are direct competitors).
model GraphRelation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fromEntityId String
  fromEntity   GraphEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId   String
  toEntity     GraphEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  type  GraphRelationType
  label String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("graph_relations")
}

// ── Knowledge Graph v2 (spec ATLAS v2, B.2) — fondation ────────────────
//
// Coexiste avec GraphEntity/GraphRelation/DealEntityLink ci-dessus le temps
// de la transition : le graphe visuel (graph.service.ts, graph-page.tsx)
// continue de tourner sur l'ancien modèle jusqu'à ce que B.3 (requêtes
// déterministes) vienne consommer celui-ci. Chaque GraphEntity/GraphRelation
// existant est migré ici (même id, traçabilité directe) — jamais supprimé.

enum EntityType {
  PROMOTEUR
  BANQUE
  NOTAIRE
  ARCHITECTE
  COLLECTIVITE
  INVESTISSEUR
  PLATEFORME
  /// Miroir d'un Deal — absent de l'ancien GraphEntityType, permet à une
  /// Relationship de pointer nativement vers une opération (ex. "caution
  /// partagée entre Opération X et Opération Y", B.3).
  OPERATION
  /// Personne physique (dirigeant, associé, bénéficiaire effectif) — spec
  /// Market Relationship & Contagion Intelligence V2, §5.1. Première classe
  /// au même titre qu'une société : peut porter ses propres Relationship
  /// (MANAGES/BENEFICIAL_OWNER_OF/SHAREHOLDER_OF → Company) plutôt que
  /// n'exister qu'en tant qu'attribut texte (GraphEntity.contactName).
  PERSON
}

/// Portfolio = contreparties réelles liées à des opérations LPB (+ les Deals
/// eux-mêmes) ; Market = veille concurrentielle. Champ explicite plutôt que
/// deux graphes séparés, pour permettre le croisement futur (B.8) sans
/// dupliquer l'infrastructure.
enum EntityDomain {
  PORTFOLIO
  MARKET
}

/// Niveau de couverture relationnelle (section 0.2 de la spec) — jamais
/// "aucun lien détecté" sans préciser le niveau de complétude de la
/// documentation elle-même.
enum RelationshipCoverage {
  UNKNOWN
  PARTIAL
  SUBSTANTIAL
  VERIFIED
}

model Entity {
  /// Pas de @default(cuid()) : les entités migrées réutilisent l'id
  /// GraphEntity d'origine, les miroirs de deal utilisent `deal_<dealId>`
  /// (dérivable sans table de mapping), les nouvelles entités reçoivent un
  /// cuid généré côté service.
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        EntityType
  domain      EntityDomain @default(PORTFOLIO)
  name        String
  description String?
  metadata    Json?

  coverage RelationshipCoverage @default(UNKNOWN)

  /// Non-null uniquement pour les entités miroir d'un Deal (type OPERATION).
  mirrorsDealId String? @unique
  mirrorsDeal   Deal?   @relation(fields: [mirrorsDealId], references: [id], onDelete: Cascade)

  identifiers       EntityIdentifier[]
  aliases           EntityAlias[]
  relationshipsFrom Relationship[]                 @relation("RelFrom")
  relationshipsTo   Relationship[]                 @relation("RelTo")
  groupMemberships  EconomicGroupMember[]
  legalEvents       LegalEvent[]
  financialEvents   FinancialEvent[]
  contagionSignals  ContagionSignal[]
  observationLinks  ProjectObservationEntityLink[]
  prequalPeople     PrequalPerson[]
  prequalCompanies  PrequalCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, domain])
  @@index([type])
  @@map("entities")
}

enum EntityIdentifierType {
  SIREN
  SIRET
  RCS
  AUTRE
}

model EntityIdentifier {
  id         String               @id @default(cuid())
  entityId   String
  entity     Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type       EntityIdentifierType
  value      String
  /// Dernière vérification (SIRENE/BODACC) — alimente le badge de fraîcheur (0.3).
  verifiedAt DateTime?

  @@unique([entityId, type, value])
  @@index([type, value])
  @@map("entity_identifiers")
}

/// Variantes de nom observées pour une entité (ex. raison sociale abrégée,
/// nom commercial différent du nom légal) — jamais fusionnées automatiquement
/// avec le nom canonique.
model EntityAlias {
  id       String  @id @default(cuid())
  entityId String
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias    String
  source   String?

  @@index([entityId])
  @@map("entity_aliases")
}

/// Taxonomie des types de relation — table plutôt qu'enum Prisma pour pouvoir
/// en ajouter sans migration. Seed fixe pour l'instant (pas d'UI d'admin) :
/// voir entity-graph.seed dans EntityGraphModule.
model RelationshipType {
  key         String  @id
  label       String
  /// Catégorie de filtre pour le graphe visuel (B.7) : Financial/Legal/Ownership/Guarantees/Projects/Autre.
  category    String
  description String?

  relationships Relationship[]

  @@map("relationship_types")
}

enum RelationshipStatus {
  ACTIVE
  ENDED
  DISPUTED
}

/// Niveau de preuve d'une relation — jamais une simple affirmation traitée
/// comme un fait vérifié.
enum EvidenceLevel {
  DECLARED
  DOCUMENTED
  OFFICIAL
}

model Relationship {
  /// Pas de @default(cuid()) : les relations migrées réutilisent l'id GraphRelation d'origine.
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceEntityId String
  sourceEntity   Entity @relation("RelFrom", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntityId String
  targetEntity   Entity @relation("RelTo", fields: [targetEntityId], references: [id], onDelete: Cascade)

  typeKey String
  type    RelationshipType @relation(fields: [typeKey], references: [key])

  startedAt   DateTime?
  endedAt     DateTime?
  amount      Decimal?  @db.Decimal(14, 2)
  percentage  Decimal?  @db.Decimal(5, 2)
  /// 0-100 — poids de ce lien pour une future analyse de contagion (B.4/B.5, pas construite ici).
  criticality Int       @default(0)

  status          RelationshipStatus   @default(ACTIVE)
  /// Niveau de couverture documentaire — sert aussi de statut de
  /// vérification (spec V2 §5.3 "verification_status") : UNKNOWN/PARTIAL
  /// tant qu'aucune source ne confirme le lien, VERIFIED une fois recoupé.
  confidence      RelationshipCoverage @default(UNKNOWN)
  /// Score numérique 0-100 (spec V2 §5.3 "confidence_score") — distinct de
  /// `confidence` : ce dernier est un palier de preuve documentaire,
  /// celui-ci une estimation continue (ex. Entity Resolution peut poser 60
  /// sur un rapprochement nom+ville sans preuve documentée du tout, avant
  /// même le premier palier de `confidence`).
  confidenceScore Int?
  /// Date d'observation du lien lui-même (spec V2 §5.3 "observed_at"),
  /// distincte de `Evidence.createdAt` (date d'ajout d'une preuve en base)
  /// et de `verifiedAt` (dernière vérification) — ex. une relation
  /// reconstruite à partir d'un acte notarié observe la date de l'acte, pas
  /// la date à laquelle Atlas l'a saisie.
  observedAt      DateTime?
  verifiedAt      DateTime?

  evidence         Evidence[]
  events           RelationshipEvent[]
  observationLinks ProjectObservationEntityLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([typeKey])
  @@map("relationships")
}

model Evidence {
  id             String       @id @default(cuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  level     EvidenceLevel
  source    String
  reference String?
  note      String?

  /// Nullable : une preuve migrée depuis l'ancien GraphRelation n'a pas
  /// d'auteur réel — jamais attribuée à quelqu'un qui ne l'a pas créée.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([relationshipId])
  @@map("relationship_evidence")
}

enum RelationshipEventType {
  CREATED
  AMOUNT_CHANGED
  PERCENTAGE_CHANGED
  STATUS_CHANGED
  CONFIDENCE_CHANGED
  EVIDENCE_ADDED
  ENDED
}

/// Colonnes typées (avant/après) plutôt qu'un JSON générique — un
/// RelationshipEvent ne couvre que les champs qui changent réellement dans la
/// vie d'une relation.
model RelationshipEvent {
  id             String       @id @default(cuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  eventType RelationshipEventType

  previousAmount     Decimal?              @db.Decimal(14, 2)
  newAmount          Decimal?              @db.Decimal(14, 2)
  previousPercentage Decimal?              @db.Decimal(5, 2)
  newPercentage      Decimal?              @db.Decimal(5, 2)
  previousStatus     RelationshipStatus?
  newStatus          RelationshipStatus?
  previousConfidence RelationshipCoverage?
  newConfidence      RelationshipCoverage?

  note String?

  occurredAt DateTime @default(now())

  @@index([relationshipId])
  @@map("relationship_events")
}

// ── Market Relationship & Contagion Intelligence V2 ────────────────────
//
// Étend le Knowledge Graph v2 ci-dessus plutôt que de dupliquer un modèle
// parallèle : EconomicGroup rend le "groupe économique" traversable en
// plusieurs sauts (jusqu'ici uniquement inféré à un saut via
// RelationshipType.GROUPE_ECONOMIQUE, voir EntityIntelligenceService).
// LegalEvent/FinancialEvent donnent un journal d'événements par entité (la
// détection BODACC existante de CompanyMonitoringService n'écrivait jusque
// là qu'un Alert, sans trace structurée). ContagionSignal persiste enfin ce
// que ContagionService ne faisait que calculer à la volée.

/// Le groupe économique Atlas est un objet analytique, jamais présenté
/// comme un groupe juridique officiel (spec V2 §7.2) — coexiste avec
/// RelationshipType.GROUPE_ECONOMIQUE (edges pairwise, toujours valides)
/// plutôt que de le remplacer : ce modèle ajoute la clôture transitive
/// (membership explicite) sans invalider les relations déjà saisies.
model EconomicGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  members EconomicGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("economic_groups")
}

model EconomicGroupMember {
  id      String        @id @default(cuid())
  groupId String
  group   EconomicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  /// Libre (ex. "Holding", "Filiale", "Dirigeant commun") — table plutôt
  /// qu'enum, même choix que RelationshipType.category pour ne pas migrer à
  /// chaque nouveau motif de rattachement.
  role     String?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([groupId, entityId])
  @@index([entityId])
  @@map("economic_group_members")
}

enum LegalEventType {
  REDRESSEMENT_JUDICIAIRE
  LIQUIDATION_JUDICIAIRE
  SAUVEGARDE
  DISSOLUTION
  RADIATION
  CHANGEMENT_DIRIGEANT
  CHANGEMENT_CONTROLE
  AUTRE
}

/// Journal d'événements juridiques par entité (spec V2 §9) — sourcé et
/// horodaté, jamais assimilé automatiquement à un défaut du projet analysé
/// (ContagionSignal fait cette évaluation séparément).
model LegalEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  type      LegalEventType
  source    String
  reference String?
  note      String?

  /// Date de l'événement lui-même (ex. date de publication BODACC) —
  /// distincte de detectedAt si Atlas l'apprend après coup.
  occurredAt DateTime?
  detectedAt DateTime  @default(now())

  contagionSignals ContagionSignal[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entityId])
  @@map("legal_events")
}

enum FinancialEventType {
  NOUVELLE_LEVEE
  PROROGATION
  RETARD
  DEFAUT
  REMBOURSEMENT
  AUTRE
}

/// Journal d'événements financiers par entité (spec V2 §9) — distinct de
/// RelationshipEvent, qui ne couvre que les changements de champs d'une
/// Relationship précise, pas un événement au niveau de l'entité elle-même.
model FinancialEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  type      FinancialEventType
  amount    Decimal?           @db.Decimal(14, 2)
  source    String
  reference String?
  note      String?

  occurredAt DateTime?
  detectedAt DateTime  @default(now())

  contagionSignals ContagionSignal[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entityId])
  @@map("financial_events")
}

/// Classe de lien entre l'entité affectée par un événement et le projet
/// analysé (spec V2 §7.2, table "Classe de lien") — détermine la force par
/// défaut du signal, jamais une propagation mécanique.
enum ContagionProximity {
  DIRECT
  CONTROLE_GROUPE
  OPERATEUR
  HISTORIQUE
}

enum ContagionSignalStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

/// Persiste ce que ContagionService calculait déjà sans le stocker (spec V2
/// §10) — un signal a son propre cycle de vie (OPEN → ACKNOWLEDGED/DISMISSED)
/// indépendant de l'Alert/Task qu'il déclenche éventuellement.
model ContagionSignal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Entité affectée par l'événement d'origine — pas nécessairement la
  /// société de projet elle-même (spec V2 §10.2, exemple Jean DUPONT).
  sourceEntityId String
  sourceEntity   Entity @relation(fields: [sourceEntityId], references: [id], onDelete: Cascade)

  legalEventId     String?
  legalEvent       LegalEvent?     @relation(fields: [legalEventId], references: [id], onDelete: SetNull)
  financialEventId String?
  financialEvent   FinancialEvent? @relation(fields: [financialEventId], references: [id], onDelete: SetNull)

  proximity             ContagionProximity
  /// Explicite plutôt qu'implicite dans le texte — spec V2 §10.2 : "la
  /// contagion directe au projet n'est pas démontrée" doit rester une
  /// donnée structurée, filtrable, pas seulement une phrase.
  contagionDemonstrated Boolean            @default(false)
  additionalExposure    Decimal?           @db.Decimal(14, 2)
  explanation           String

  status     ContagionSignalStatus @default(OPEN)
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?

  @@index([organizationId])
  @@index([dealId])
  @@index([sourceEntityId])
  @@map("contagion_signals")
}

// ── Playbooks (spec ATLAS v2, A.4 / A.7) ───────────────────────────────
//
// Un seul playbook codé en dur dans ce lot : "procédure_collective_ouverte"
// (voir apps/api/src/playbooks/procedure-collective.playbook.ts). Bibliothèque
// étendue par type d'événement = NEXT, pas construite ici.

enum PlaybookEventType {
  PROCEDURE_COLLECTIVE_OUVERTE
}

/// Une instance par (dossier, type d'événement) — jamais recréée deux fois
/// pour le même dossier, quel que soit le signal qui l'a déclenchée
/// (recoveryStatus manuel ou détection BODACC automatique).
model PlaybookInstance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  eventType PlaybookEventType

  /// 'recovery_status_manuel' | 'surveillance_bodacc_auto' — traçabilité, sans incidence fonctionnelle.
  triggerSource String
  triggeredAt   DateTime @default(now())

  /// Ancre des délais légaux (ex. date_publication_BODACC) — par défaut
  /// triggeredAt, corrigeable ensuite par l'analyste (recalcule alors les
  /// échéances des actions pas encore faites, jamais celles déjà cochées).
  anchorDate DateTime

  actions PlaybookActionItem[]

  @@unique([dealId, eventType])
  @@index([organizationId])
  @@map("playbook_instances")
}

/// Adossée à une Task existante plutôt que de dupliquer un statut : le
/// statut affiché (à faire / fait / en retard) se dérive directement de
/// Task.done et Task.dueDate — zéro désynchronisation possible, zéro
/// nouvelle UI de complétion (l'onglet Tâches existant suffit).
model PlaybookActionItem {
  id                 String           @id @default(cuid())
  playbookInstanceId String
  playbookInstance   PlaybookInstance @relation(fields: [playbookInstanceId], references: [id], onDelete: Cascade)

  /// Clé stable de l'action dans le playbook (ex. "declaration_creance").
  key String

  bloquant Boolean @default(false)

  /// Garde-fou de la spec (A.4) : une action à conséquence juridique/
  /// financière significative est proposée par le système mais jamais
  /// marquée "faite" par lui — toujours vrai dans ce lot, exposé pour que
  /// le futur workflow d'approbation (A.10) ait une donnée à consommer.
  requiresHumanValidation Boolean @default(true)

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([playbookInstanceId, key])
  @@index([playbookInstanceId])
  @@map("playbook_action_items")
}

enum CompetitorProjectStatus {
  A_VENIR
  EN_COLLECTE
  CLOTURE
}

/// Manually logged by an analyst against a competitor PLATEFORME entity —
/// there's no automated feed for a competitor's live/upcoming project
/// listing (their "app" is behind a login, and scraping an authenticated
/// competitor account is out of scope), so this is deliberately a fast,
/// low-friction manual log rather than a sync target.
model CompetitorProject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityId       String
  entity         GraphEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name         String
  status       CompetitorProjectStatus @default(EN_COLLECTE)
  targetAmount Decimal?                @db.Decimal(14, 2)
  expectedDate DateTime?
  url          String?
  note         String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([entityId])
  @@map("competitor_projects")
}

enum CompetitorProjectEventType {
  PROJECT_DETECTED
  FUNDING_OPENED
  FUNDING_CLOSED
  PROJECT_REMOVED
  PROJECT_UPDATED
}

/// Historique d'un CompetitorProject (spec ATLAS v2, C.3 — vocabulaire
/// d'événements minimal). Colonnes dénormalisées (entityId, projectName)
/// plutôt qu'une FK stricte vers CompetitorProject : PROJECT_REMOVED doit
/// rester consultable après la suppression de la ligne qu'il décrit.
model CompetitorProjectEvent {
  id             String                     @id @default(cuid())
  entityId       String
  entity         GraphEntity                @relation(fields: [entityId], references: [id], onDelete: Cascade)
  projectId      String
  projectName    String
  eventType      CompetitorProjectEventType
  previousStatus CompetitorProjectStatus?
  newStatus      CompetitorProjectStatus?
  occurredAt     DateTime                   @default(now())

  @@index([entityId])
  @@map("competitor_project_events")
}

// ── Intelligence Marché: news pipeline ─────────────────────

enum SourceHealth {
  OPERATIONAL
  DEGRADED
  BROKEN
  UNKNOWN
}

enum SourceApprovalStatus {
  APPROVED_FOR_COLLECTION
  PENDING_REVIEW
}

/// Source Registry (spec ATLAS v2, C.2) — un enregistrement par connecteur
/// (pas par organisation, pas par NewsSource : plusieurs NewsSource peuvent
/// partager le même connecteur, ex. 9 lignes utilisent google-news-rss).
/// Aucune source ne doit collecter avant que son statut soit
/// APPROVED_FOR_COLLECTION — la conformité/santé d'une source externe est
/// un fait sur la source elle-même, pas sur le tenant qui la consulte
/// (même principe que RelationshipType, clé globale sans organizationId).
model SourceRegistryEntry {
  key                    String               @id
  label                  String
  accessMethod           String
  termsReviewed          Boolean              @default(false)
  reviewedAt             DateTime?
  authenticationRequired Boolean              @default(false)
  approvalStatus         SourceApprovalStatus @default(PENDING_REVIEW)

  // Source Monitor (C.3)
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  health        SourceHealth @default(UNKNOWN)
  lastChangeAt  DateTime?

  /// Curseur de fraîcheur pour une source consommée en flux RSS/Atom (spec
  /// ATLAS v2, E.4) — horodatage du plus récent item déjà traité, pour
  /// détecter une nouvelle entrée sans dépendre d'un identifiant de flux
  /// particulier. Null pour toute source qui n'est pas consommée ainsi.
  lastRssItemAt DateTime?

  updatedAt DateTime @updatedAt

  crowdfundingPlatform CrowdfundingPlatform?

  @@map("source_registry_entries")
}

/// Un instantané par synchronisation réussie ET changée (spec C.3 : "ne
/// jamais écraser l'état précédent"). GraphEntity.metadata reste la vue
/// "état courant" déjà lue par PlatformStatsPanel — ce modèle porte
/// l'historique que la mise à jour en place ne conservait pas.
model PlatformStatsSnapshot {
  id         String      @id @default(cuid())
  entityId   String
  entity     GraphEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  metadata   Json
  observedAt DateTime    @default(now())

  @@index([entityId, observedAt])
  @@map("platform_stats_snapshots")
}

/// A configured source for the market-intelligence pipeline. `connector`
/// names the ingestion strategy — a registered code connector (e.g.
/// "data-gouv-dvf") or "manual" for analyst-entered items.
model NewsSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  connector     String
  url           String?
  active        Boolean   @default(true)
  lastFetchedAt DateTime?

  articles Article[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@map("news_sources")
}

model Article {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId       String
  source         NewsSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String
  summary     String?
  url         String?
  category    ArticleCategory @default(AUTRE)
  publishedAt DateTime
  /// Hash of title+url used to deduplicate re-fetched items across runs.
  dedupeHash  String          @unique
  priority    Priority        @default(MEDIUM)

  entities ArticleEntityLink[]
  alerts   Alert[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([category])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleEntityLink {
  id        String      @id @default(cuid())
  articleId String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entityId  String
  entity    GraphEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([articleId, entityId])
  @@map("article_entity_links")
}

// ── Crowdfunding Watch (spec ATLAS v2, C.1-C.9 + spec Lot 1 "Veille crowdfunding") ──
//
// Évolution du pilote Market Intelligence Engine (C.1-C.3, modèles conservés
// et étendus en place — même identité (sourceKey, projectUrl), aucun
// backfill requis) vers un module de production : registre de plateformes en
// base (au lieu du tableau TS figé pilot-sources.config.ts), dates
// annonce/ouverture séparées, règle "premier sync = état initial", et
// rapprochement avec les entités Atlas via l'Entity Resolution Engine.

enum ProjectObservationStatus {
  A_VENIR
  EN_COLLECTE
  CLOTURE
  RETIRE
}

enum CrowdfundingConnectorStatus {
  /// Vérifié contre une page/réponse réelle en production — jamais posé automatiquement.
  OPERATIONAL
  /// Code de collecte existant mais partiellement fiable ou jamais observé contre la source réelle.
  PARTIAL
  /// Accès refusé/restreint par la source — pas un problème de code.
  BLOCKED
  /// Enregistrement de registre créé, aucun connecteur écrit.
  TO_BUILD
}

/// Registre extensible des plateformes de crowdfunding (spec §1 — "ajout de
/// plateformes sans modification du cœur du système") : une ligne en base
/// suffit à déclarer une nouvelle plateforme, le PlatformRegistryService la
/// reconcilie automatiquement dans les jobs répétables de détection. 1:1
/// avec SourceRegistryEntry (qui reste le registre générique de santé
/// cross-fonctionnalités, partagé avec intelligence-marche et
/// intelligence-concurrentielle) : CrowdfundingPlatform porte les champs
/// spécifiques à ce module.
model CrowdfundingPlatform {
  sourceKey     String              @id
  registryEntry SourceRegistryEntry @relation(fields: [sourceKey], references: [key], onDelete: Cascade)

  label        String
  platformName String
  country      String  @default("FR")
  /// Nullable : une plateforme "à développer" (spec §1) peut être déclarée dans le registre avant même qu'une URL de listing soit confirmée.
  listingUrl   String?
  accessMethod String  @default("scraping")

  /// Déclaré par un humain après vérification — jamais promu automatiquement
  /// par un cycle de synchronisation réussi (spec §1 : "ne jamais présenter
  /// une plateforme comme surveillée si son connecteur n'est pas opérationnel").
  connectorStatus                    CrowdfundingConnectorStatus @default(TO_BUILD)
  authenticationRequiredForDocuments Boolean                     @default(false)
  coverageNotes                      String?

  /// Fréquence visée — jamais 60s par défaut sans preuve de tolérance réelle de la source (spec §2).
  targetCheckFrequencySeconds    Int       @default(3600)
  /// Intervalle moyen mesuré entre deux vérifications réussies — alimenté par le sync, jamais saisi manuellement.
  effectiveCheckFrequencySeconds Int?
  /// Posé une seule fois, à l'intérieur du verrou du tout premier cycle réussi — sert à ne jamais notifier rétroactivement l'historique.
  baselineCompletedAt            DateTime?

  observations ProjectObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crowdfunding_platforms")
}

/// Observation automatisée d'un projet individuel sur une plateforme externe
/// (spec C.3 + spec Lot 1 §2-3) — distinct de CompetitorProject, qui est un
/// constat manuel d'analyste sans flux automatisé. Global, pas
/// d'organizationId : une observation de marché est un fait externe, pas une
/// donnée par tenant — même doctrine que SourceRegistryEntry.
model ProjectObservation {
  id                String                   @id @default(cuid())
  sourceKey         String
  platform          CrowdfundingPlatform     @relation(fields: [sourceKey], references: [sourceKey], onDelete: Cascade)
  projectName       String
  projectUrl        String
  operatorRaw       String?
  amountTarget      Decimal?                 @db.Decimal(14, 2)
  ratePct           Decimal?                 @db.Decimal(5, 2)
  durationMonths    Int?
  /// Catégorie telle qu'affichée par la source — jamais écrasée par la normalisation (spec C.4).
  sourceCategory    String?
  /// Segment ATLAS normalisé (best-effort) — null si aucune correspondance de confiance suffisante.
  atlasSegment      String?
  mappingConfidence String?
  location          String?
  status            ProjectObservationStatus @default(EN_COLLECTE)

  /// Conservées séparément (spec §2) — aucune n'est dérivée d'une autre.
  publishedAt        DateTime?
  /// Date d'ouverture annoncée par la source — jamais traitée comme une preuve d'ouverture effective.
  announcedOpeningAt DateTime?
  /// Posée uniquement quand le connecteur trouve un indicateur explicite d'ouverture sur la source — jamais dérivée d'une date programmée dépassée.
  effectiveOpeningAt DateTime?
  /// Immuable — posée une seule fois à la création.
  firstDetectedAt    DateTime  @default(now())
  lastCheckedAt      DateTime?
  /// Dernière vérification réussie pour CETTE observation — distinct du niveau plateforme (CrowdfundingPlatform via SourceRegistryEntry).
  lastSuccessAt      DateTime?
  /// Créée lors du tout premier sync réussi de sa plateforme — jamais notifiée (spec §2 : "état initial").
  isBaseline         Boolean   @default(false)
  /// Posée une fois le rapprochement d'entités passé pour toutes les organisations courantes — distingue "aucun lien identifié" de "pas encore analysé".
  enrichedAt         DateTime?

  observedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots   ProjectObservationSnapshot[]
  entityLinks ProjectObservationEntityLink[]

  @@unique([sourceKey, projectUrl])
  @@index([sourceKey])
  @@index([enrichedAt])
  @@map("project_observations")
}

/// Un instantané par synchronisation ayant détecté un changement (spec C.3 :
/// "ne jamais écraser l'état précédent") — même pattern que
/// PlatformStatsSnapshot, appliqué ici à l'observation avant écrasement.
model ProjectObservationSnapshot {
  id            String             @id @default(cuid())
  observationId String
  observation   ProjectObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  data          Json
  observedAt    DateTime           @default(now())

  @@index([observationId, observedAt])
  @@map("project_observation_snapshots")
}

/// Historique d'une ProjectObservation — réutilise le vocabulaire
/// d'événements de CompetitorProjectEvent (même enum), pas une redéfinition.
/// Colonnes dénormalisées (sourceKey/projectUrl/projectName) plutôt qu'une FK
/// stricte : PROJECT_REMOVED doit rester consultable même après suppression
/// de l'observation qu'il décrit.
model ProjectObservationEvent {
  id             String                     @id @default(cuid())
  sourceKey      String
  projectUrl     String
  projectName    String
  eventType      CompetitorProjectEventType
  previousStatus ProjectObservationStatus?
  newStatus      ProjectObservationStatus?
  occurredAt     DateTime                   @default(now())

  /// Événement du tout premier sync d'une plateforme — visible dans le flux, jamais notifié (spec §2).
  isBaseline            Boolean   @default(false)
  /// FUNDING_OPENED sans PROJECT_DETECTED préalable observé — déclenche une notification unique et explicitement flaguée (spec §2).
  discoveredAlreadyOpen Boolean   @default(false)
  /// Horodatage propre à la source, quand disponible — sert à mesurer le délai réel de détection (occurredAt - sourceObservedAt).
  sourceObservedAt      DateTime?
  /// Idempotence de la notification — posé par le NotificationProcessor, permet un sweep de reprise sans doublon.
  notifiedAt            DateTime?

  alerts Alert[]

  @@index([sourceKey])
  @@map("project_observation_events")
}

enum EntityLinkMatchType {
  /// Correspondance directe par identifiant légal (SIREN) — auto-confirmée.
  DIRECT_ID
  /// Lien documenté par détention, contrôle ou direction.
  DOCUMENTED
  /// Correspondance potentielle nécessitant une validation manuelle — jamais fusionnée automatiquement.
  POTENTIAL
}

enum EntityLinkConfidence {
  HIGH
  MEDIUM
  LOW
}

enum EntityLinkStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

/// File de rapprochement entre une observation de marché et une Entity Atlas
/// (spec §4) — c'est à la fois la file de validation manuelle et
/// l'enregistrement des liens confirmés. L'absence de toute ligne pour une
/// observation dont `enrichedAt` est posé signifie "aucun lien identifié"
/// (jamais une certitude d'absence de lien) ; l'absence de ligne avec
/// `enrichedAt` nul signifie "pas encore analysé" — les deux cas ne doivent
/// jamais être confondus à l'affichage.
model ProjectObservationEntityLink {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  observationId  String
  observation    ProjectObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  entityId       String
  entity         Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)

  matchType  EntityLinkMatchType
  confidence EntityLinkConfidence
  status     EntityLinkStatus     @default(SUGGESTED)

  /// Posé uniquement une fois confirmé — matérialise le lien dans le Knowledge Graph v2 (Relationship + Evidence DOCUMENTED).
  relationshipId String?
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedBy      User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  /// Idempotence de "l'alerte complémentaire unique si le rapprochement est confirmé après la première notification" (spec §6) — même doctrine que ProjectObservationEvent.notifiedAt.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([observationId, organizationId, entityId])
  @@index([organizationId, status])
  @@map("project_observation_entity_links")
}

// ── Fractionné — Underwriting institutionnel (spec V3.0 + patch V3.2) ──────
//
// Périmètre P0 (Fondation + Underwriting + Fractionné, roadmap spec §28) :
// modèle de données du dossier, sources/uses, baux + Lease Security Engine,
// CAPEX, valorisation, profil plateforme versionné, structure véhicule,
// données de marché partagées (RentIndexSeries/MarketComparablePool, patch
// V3.2 §2). Explicitement DIFFÉRÉ à un lot ultérieur (P1/P2 du même
// roadmap) : Tenant Covenant Intelligence, DD Technique/ESG détaillée,
// Stress Testing Engine, IC Engine complet (hard stops/conditions/workflow
// d'approbation), Investment Memory (Actuals/Outcome/Performance
// Attribution/Comparable/Learning Engine). La provenance par donnée (spec
// §3, un objet metadata complet par champ) est simplifiée en P0 à des
// champs source/asOfDate/confidence au niveau de l'objet plutôt que par
// valeur individuelle — des centaines de champs avec provenance dédiée
// chacun n'est pas tractable pour un premier lot fonctionnel.

enum FractionalProjectStatus {
  ANALYSE
  STRUCTURATION
  VALIDATION_PLATEFORME
  COLLECTE
  ACQUISITION
  EXPLOITATION
  SORTIE
  REFUSE
  ABANDONNE
}

enum FractionalAssumptionScenario {
  BASE
  BEAR
  SEVERE
  CUSTOM
}

enum FractionalIndexationType {
  ILC
  ILAT
  IRL
  ICC
  AUTRE
}

enum FractionalLeaseRenewalStatus {
  SIGNE
  EN_COURS
  TACITE
  DEPASSE
  CONTESTE
}

enum FractionalLeaseSecurityStatus {
  SECURED
  WATCH
  SECURE_BEFORE_ACQUISITION
  EXCLUDE_FROM_SECURED_YIELD
}

enum FractionalCapexResponsable {
  PROPRIETAIRE
  LOCATAIRE
}

enum FractionalValuationMethod {
  CAPITALISATION
  DCF
  COMPARABLE_SALES
  COST_REPLACEMENT
  EXTERNAL_APPRAISAL
}

enum FractionalVehicleInstrumentType {
  OBLIGATION
  ACTION
  AUTRE
}

enum RentIndexType {
  ILC
  ILAT
  IRL
  ICC
}

enum MarketComparableType {
  LOYER
  VENTE
}

/// Fractionné — entité de premier niveau, pas une variante de Deal (patch
/// V3.2 §1) : logique économique différente (participation/exploitation,
/// sortie en plus-value, waterfall investisseur) d'un dossier LPB (créance).
/// Visibilité scopée à son créateur (createdById) — jamais remontée dans le
/// Cockpit organisationnel ni un reporting visible par d'autres utilisateurs
/// de l'organisation (hypothèse posée par défaut par le patch V3.2 §1,
/// gouvernance à reconfirmer si elle doit être différente).
model FractionalProject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  name      String
  reference String                  @unique
  status    FractionalProjectStatus @default(ANALYSE)

  /// Regroupe les scénarios de périmètre d'un même dossier physique (ex.
  /// Meyzieu "parc seul" / "terrain" / "ensemble", spec §22) — chaque
  /// périmètre est un FractionalProject séparé partageant ce groupKey, pour
  /// ne jamais mélanger loyers/prix/rendement entre périmètres (règle
  /// explicite du DoD §27).
  groupKey       String?
  perimeterLabel String?

  address  String?
  city     String?
  postcode String?
  country  String  @default("FR")

  /// Typologie libre (ex. "Commerce", "Activités", "Bureaux", "Mixte") —
  /// sélectionne le barème de scoring et les règles éliminatoires
  /// applicables (Complément H point 1, weighted-score.util.ts). Null = pas
  /// encore qualifié, seul le barème générique (assetType null) s'applique
  /// — jamais une typologie devinée silencieusement.
  assetType String?

  notes String?

  sourcesUses          FractionalSourcesUses?
  assumptionSets       FractionalAssumptionSet[]
  leases               FractionalLease[]
  capexItems           FractionalCapexItem[]
  valuations           FractionalValuation[]
  vehicleStructure     FractionalVehicleStructure?
  stakeholders         FractionalStakeholder[]
  feeDefinitions       FractionalFeeDefinition[]
  waterfallTiers       FractionalWaterfallTier[]
  icDecisions          FractionalICDecision[]
  actuals              FractionalProjectActual[]
  outcome              FractionalProjectOutcome?
  alerts               Alert[]
  scoreAssessments     FractionalScoreAssessment[]
  dataProvenance       FractionalDataProvenance[]
  dataRoomItemStatuses FractionalDataRoomItemStatus[]
  esgAssessment        FractionalEsgAssessment?
  technicalAssessments FractionalTechnicalAssessment[]
  legalTaxItemStatuses FractionalLegalTaxItemStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([groupKey])
  @@map("fractional_projects")
}

enum FractionalProvenanceSourceLevel {
  LEVEL_A_LEGAL_EXECUTED
  LEVEL_B_THIRD_PARTY_VERIFIED
  LEVEL_C_INVESTMENT_OPERATOR_DOCUMENT
  LEVEL_D_DECLARATIVE
  LEVEL_E_ATLAS_ASSUMPTION
}

enum FractionalProvenanceVerificationStatus {
  UNVERIFIED
  CROSS_CHECKED
  VERIFIED
  CONFLICTING
}

enum FractionalProvenanceConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Data Integrity Engine — schéma de provenance unifié (V3.1 §3 : owner/
/// version/override ; V2 §3 : hiérarchie de sources Level A "légal/exécuté"
/// à Level E "hypothèse Atlas"), généralisé à n'importe quel champ de
/// n'importe quelle entité Fractionné (entityType/entityId/fieldKey), plutôt
/// que les paires source/confidence ad hoc déjà présentes sur quelques
/// modèles (PlatformFractionalProfile...) — celles-ci restent inchangées,
/// pas rétrofittées ici. Ne stocke JAMAIS une copie de la valeur elle-même
/// (Single Source of Truth, V2 §2) : uniquement sa provenance, affichée à
/// côté du champ réel qui reste l'unique source de calcul.
model FractionalDataProvenance {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  fieldKey   String

  sourceLevel        FractionalProvenanceSourceLevel
  sourceReference    String?
  asOfDate           DateTime?
  observedAt         DateTime                               @default(now())
  verificationStatus FractionalProvenanceVerificationStatus @default(UNVERIFIED)
  confidence         FractionalProvenanceConfidence

  ownerId String?

  /// Valeur modifiée manuellement par rapport à la source documentaire —
  /// justification obligatoire (V3.1 §3 "override"), jamais un override
  /// silencieux.
  isOverride            Boolean @default(false)
  overrideJustification String?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, fieldKey])
  @@index([projectId])
  @@map("fractional_data_provenance")
}

enum FractionalDataRoomItemStatusValue {
  OBTAINED
  MISSING
  NOT_APPLICABLE
  INCONSISTENT
}

/// Data Room Completeness Engine (spec V3.1 §4) — registre fermé de blocs DD
/// et pièces attendues (data-room-completeness.util.ts), jamais un champ
/// libre : c'est ce qui permet à Atlas de générer automatiquement la liste
/// des éléments manquants/incohérents sans dépendre d'une saisie ad hoc.
/// Une pièce sans ligne ici = MISSING par défaut (Unknown ≠ Zero, même
/// principe que FractionalDataProvenance) — seul un changement de statut
/// crée une ligne, jamais un pré-remplissage silencieux de tout le registre
/// à la création du dossier.
model FractionalDataRoomItemStatus {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  block   String
  itemKey String

  status FractionalDataRoomItemStatusValue
  notes  String?

  updatedById String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([projectId, block, itemKey])
  @@index([projectId])
  @@map("fractional_data_room_item_statuses")
}

enum FractionalDpeClass {
  A
  B
  C
  D
  E
  F
  G
}

enum FractionalEsgEquipmentTier {
  NEUF
  BON
  VETUSTE
  OBSOLETE
}

enum FractionalEsgPhysicalRiskTier {
  FAIBLE
  MODERE
  ELEVE
}

/// ESG, Energy & Obsolescence Risk Engine (spec V3.1 §12) — un seul
/// enregistrement par dossier (contrairement à FractionalDataRoomItemStatus
/// qui a une ligne par pièce), car chaque dimension ESG est évaluée une fois
/// pour l'actif entier. Champs volontairement nullables sans défaut implicite
/// (sauf booléens factuels type decreeTertiaireSubject/greenLeaseClauses,
/// affirmativement cochés par l'analyste) : esg-risk.util.ts ne devine jamais
/// une classe DPE ou un niveau d'obsolescence absent, il le signale comme
/// non évalué plutôt que de l'assimiler à "sans risque" (Unknown ≠ Zero).
/// Distinct des champs esg* du modèle Deal (dette privée) qui sont
/// volontairement informatifs sans impact calculatoire — ici au contraire
/// l'ESG est relié à un impact CAPEX/valorisation chiffré, conformément à
/// l'exigence explicite de la spec ("pas un score décoratif").
model FractionalEsgAssessment {
  id        String            @id @default(cuid())
  projectId String            @unique
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dpeClass               FractionalDpeClass?
  consumptionKwhM2An     Decimal?            @db.Decimal(8, 2)
  decreeTertiaireSubject Boolean             @default(false)

  equipmentConditionTier FractionalEsgEquipmentTier?
  physicalRiskExposure   FractionalEsgPhysicalRiskTier?
  greenLeaseClauses      Boolean                        @default(false)

  notes String?

  updatedById String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("fractional_esg_assessments")
}

enum FractionalTechnicalSubBlock {
  BATIMENT
  CONFORMITE
  ETAT
  ADAPTABILITE
  OBSOLESCENCE
  ENVIRONNEMENT
  ASSURANCE
}

enum FractionalTechnicalTier {
  BON
  MOYEN
  MAUVAIS
  CRITIQUE
}

/// Asset & Technical Due Diligence Engine (spec V3.1 §6) — registre fermé des
/// 7 sous-blocs techniques (technical-dd.util.ts), mirroté sur
/// FractionalDataRoomItemStatus : une ligne par dossier/sous-bloc, jamais un
/// champ libre. Un sous-bloc sans ligne ici est "non évalué" (Unknown ≠
/// Zero) — computeTechnicalRiskRating ne l'assimile jamais à BON par défaut.
/// Le plan CAPEX par horizon (0-1/1-3/3-5/5-10 ans) n'est volontairement PAS
/// stocké ici : il est recalculé à la lecture à partir des
/// FractionalCapexItem existants (annee/montant/responsable), déjà la seule
/// source qui alimente NOI/IRR (fractional-projects.service.ts
/// #buildReturnsEngineInput) — Single Source of Truth, jamais un second
/// plan CAPEX qui pourrait diverger du premier.
model FractionalTechnicalAssessment {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  subBlock FractionalTechnicalSubBlock

  tier               FractionalTechnicalTier
  conditionPrealable Boolean                 @default(false)
  notes              String?

  updatedById String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([projectId, subBlock])
  @@index([projectId])
  @@map("fractional_technical_assessments")
}

enum FractionalLegalTaxItemStatusValue {
  NON_CONTROLE
  CONFORME
  RESERVE
}

/// Legal, Planning & Tax DD Engine (spec V3.1 §13) — registre fermé des SEULS
/// sous-blocs non déjà couverts ailleurs dans Atlas (legal-tax-dd.util.ts) :
/// Titre → Data Room bloc TITLE_LEGAL, Environnement → Data Room +
/// Technical DD sous-bloc ENVIRONNEMENT, Baux → lease-legal-review.util.ts,
/// Assurance → Technical DD sous-bloc ASSURANCE. Dupliquer ces 4 blocs ici
/// romprait le Single Source of Truth ; seuls Urbanisme/Fiscalité véhicule/
/// Contentieux restent sans registre dédié. Statut à trois états (pas le
/// vocabulaire OBTAINED/MISSING de la Data Room) : NON_CONTROLE (pas encore
/// examiné, défaut implicite — Unknown ≠ Zero), CONFORME (examiné, sans
/// réserve), RESERVE (examiné, réserve levée — signale automatiquement le
/// type de professionnel requis via le registre fermé LEGAL_TAX_BLOCKS,
/// jamais une simple case cochée).
model FractionalLegalTaxItemStatus {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  block   String
  itemKey String

  status FractionalLegalTaxItemStatusValue
  notes  String?

  updatedById String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([projectId, block, itemKey])
  @@index([projectId])
  @@map("fractional_legal_tax_item_statuses")
}

/// Hypothèses Base/Bear/Severe/Custom versionnées (spec §0 "AssumptionSet",
/// P0-Fondation). values porte les paramètres de scénario libres (taux de
/// vacance, croissance loyers, exit yield...) en JSON plutôt qu'une colonne
/// par paramètre : la liste varie par scénario/évolution du moteur sans
/// migration à chaque ajout.
model FractionalAssumptionSet {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scenario FractionalAssumptionScenario
  version  Int                          @default(1)
  label    String?
  values   Json

  createdById String?
  createdAt   DateTime @default(now())

  @@index([projectId, scenario])
  @@map("fractional_assumption_sets")
}

/// Sources & Uses de l'acquisition (spec §5) — un seul jeu de valeurs par
/// dossier (le scénario Base) ; les variantes Bear/Severe passent par
/// FractionalAssumptionSet plutôt que de dupliquer ces colonnes.
model FractionalSourcesUses {
  id        String            @id @default(cuid())
  projectId String            @unique
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  prixNetVendeur        Decimal @db.Decimal(14, 2)
  droitsNotaire         Decimal @default(0) @db.Decimal(14, 2)
  honoraires            Decimal @default(0) @db.Decimal(14, 2)
  travauxInitiaux       Decimal @default(0) @db.Decimal(14, 2)
  capexDiffereReserve   Decimal @default(0) @db.Decimal(14, 2)
  fraisPlateformeEntree Decimal @default(0) @db.Decimal(14, 2)
  reserveVacance        Decimal @default(0) @db.Decimal(14, 2)
  reserveTravaux        Decimal @default(0) @db.Decimal(14, 2)
  reserveTresorerie     Decimal @default(0) @db.Decimal(14, 2)

  collecteMontant Decimal @default(0) @db.Decimal(14, 2)
  sponsorEquity   Decimal @default(0) @db.Decimal(14, 2)
  detteEventuelle Decimal @default(0) @db.Decimal(14, 2)
  autresSources   Decimal @default(0) @db.Decimal(14, 2)

  /// Régime de TVA (Complément H, H.3) — MARGE : TVA calculée par le vendeur
  /// sur sa seule marge, embarquée dans le prix négocié, sans décaissement
  /// distinct côté acheteur. PRIX_TOTAL_OPTION_LOYERS : TVA décaissée sur le
  /// prix total à l'acquisition puis récupérée après tvaRecuperationDelaiMois
  /// (calendrier déclaratif CA3/M+13-14) — c'est ce régime qui a un impact
  /// de trésorerie réel sur le TRI (tva-cashflow.util.ts), même quand le
  /// montant net de TVA est nul à terme. NON_ASSUJETTI (défaut) : hors champ,
  /// comportement inchangé pour tout dossier existant.
  regimeTva                FractionalTvaRegime @default(NON_ASSUJETTI)
  tvaTauxPct               Decimal?            @db.Decimal(5, 2)
  tvaRecuperationDelaiMois Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fractional_sources_uses")
}

enum FractionalTvaRegime {
  NON_ASSUJETTI
  MARGE
  PRIX_TOTAL_OPTION_LOYERS
}

/// Bail normalisé (spec §7/§24) — porte les données contractuelles brutes.
/// Le statut de sécurisation (SECURED/WATCH/...) n'est volontairement pas
/// stocké ici : lease-security.util.ts le recalcule à la lecture à partir de
/// ces champs + de la matérialité du dossier, pour ne jamais laisser un
/// statut en cache devenir incohérent avec les données sources.
model FractionalLease {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tenantName String
  lotLabel   String?
  surfaceM2  Decimal? @db.Decimal(10, 2)

  dateEffet  DateTime
  dateTerme  DateTime
  breakDates Json?

  loyerFacialAnnuel Decimal  @db.Decimal(14, 2)
  ervAnnuel         Decimal? @db.Decimal(14, 2)

  indexation              FractionalIndexationType @default(AUTRE)
  indexationCapPct        Decimal?                 @db.Decimal(5, 2)
  indexationFloorPct      Decimal?                 @db.Decimal(5, 2)
  prochaineDateIndexation DateTime?

  franchiseMois       Decimal @default(0) @db.Decimal(5, 2)
  chargesRecuperables Boolean @default(true)

  depotGarantieMontant Decimal? @db.Decimal(14, 2)

  statutRenouvellement            FractionalLeaseRenewalStatus @default(SIGNE)
  restrictionsCessionSousLocation String?
  repartitionTravaux              String?
  impayesNotes                    String?

  /// Tenant Covenant Intelligence (spec §8) — champs bruts uniquement, le
  /// score (0-100) est calculé à la volée par tenant-covenant.util.ts à
  /// partir de ces champs + du statut de renouvellement/impayesNotes déjà
  /// présents ci-dessus, jamais stocké (même principe que le statut de
  /// sécurisation du bail).
  sirenLocataire      String?
  procedureCollective Boolean @default(false)
  garantieMaisonMere  Boolean @default(false)

  /// Bloc Financier du Tenant Covenant (spec §8, explicitement différé en
  /// P1 faute de saisie dédiée — cf. tenant-covenant.util.ts) : dernier
  /// exercice connu du locataire, saisie manuelle (liasse fiscale/Infogreffe),
  /// jamais recalculée. Optionnels et neutres si absents, comme le reste du
  /// score de covenant.
  caLocataireAnnuel     Decimal?  @db.Decimal(16, 2)
  ebitdaLocataireAnnuel Decimal?  @db.Decimal(16, 2)
  tresorerieLocataire   Decimal?  @db.Decimal(16, 2)
  exerciceFinancierAsOf DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("fractional_leases")
}

model FractionalCapexItem {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  annee       Int
  montant     Decimal                    @db.Decimal(14, 2)
  nature      String
  responsable FractionalCapexResponsable @default(PROPRIETAIRE)
  notes       String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("fractional_capex_items")
}

model FractionalValuation {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  method     FractionalValuationMethod
  value      Decimal                   @db.Decimal(14, 2)
  capRatePct Decimal?                  @db.Decimal(5, 2)
  asOfDate   DateTime
  source     String?
  notes      String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("fractional_valuations")
}

/// Règles commerciales d'une plateforme de fractionnement (Tantiem,
/// LPB-like…), versionnées et datées — jamais codées en dur dans le moteur
/// (spec §16.1 / critère d'acceptation §26.29). Portée organisation, pas
/// projet : plusieurs FractionalProject référencent le même profil actif à
/// une date donnée via leur FractionalVehicleStructure.
model PlatformFractionalProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platformName  String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  minNetInvestorYieldPct Decimal @db.Decimal(5, 2)
  targetHoldPeriodMonths Int?
  eligibleLocations      String?
  strategyConstraints    String?

  acquisitionFeePct           Decimal @default(0) @db.Decimal(5, 2)
  annualManagementFeePct      Decimal @default(0) @db.Decimal(5, 2)
  incomeShareInvestorPct      Decimal @db.Decimal(5, 2)
  capitalGainShareInvestorPct Decimal @db.Decimal(5, 2)

  appraisalRule String?
  earlyExitRule String?

  source     String?
  confidence String?

  vehicleStructures FractionalVehicleStructure[]
  eliminatoryRules  FractionalEliminatoryRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("platform_fractional_profiles")
}

model FractionalVehicleStructure {
  id        String            @id @default(cuid())
  projectId String            @unique
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  platformProfileId String?
  platformProfile   PlatformFractionalProfile? @relation(fields: [platformProfileId], references: [id], onDelete: SetNull)

  spvName         String?
  instrumentType  FractionalVehicleInstrumentType @default(OBLIGATION)
  nominal         Decimal?                        @db.Decimal(14, 2)
  maturity        DateTime?
  amortization    String?
  governanceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformProfileId])
  @@map("fractional_vehicle_structures")
}

/// Séries d'indices de référence (ILC/ILAT/IRL/ICC) — table partagée au
/// niveau organisation, jamais dupliquée par dossier (patch V3.2 §2 : comble
/// l'angle mort "un projet ne doit jamais ressaisir l'historique des
/// indices"). Alimentée par import trimestriel (source INSEE).
model RentIndexSeries {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  indexType RentIndexType
  period    String // ex. "2026-T2"
  value     Decimal       @db.Decimal(10, 4)
  cagr5y    Decimal?      @db.Decimal(6, 3)
  cagr10y   Decimal?      @db.Decimal(6, 3)
  asOfDate  DateTime
  source    String?

  createdAt DateTime @default(now())

  @@unique([organizationId, indexType, period])
  @@index([organizationId, indexType])
  @@map("rent_index_series")
}

/// Pool de comparables marché scopé par zone géographique, jamais par
/// dossier (patch V3.2 §2) — alimenté par le scraper marché existant
/// (annonces) et par import DVF (ventes notariées) ; addedByProjectId trace
/// un comparable ponctuel ajouté manuellement depuis un dossier, qui rejoint
/// néanmoins le pool géographique plutôt que de rester une donnée isolée.
model MarketComparablePool {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  commune String
  secteur String?
  type    MarketComparableType

  valeurM2         Decimal? @db.Decimal(10, 2)
  yieldPct         Decimal? @db.Decimal(5, 2)
  surfaceM2        Decimal? @db.Decimal(10, 2)
  asOfDate         DateTime
  source           String
  addedByProjectId String?

  notes String?

  createdAt DateTime @default(now())

  @@index([organizationId, commune])
  @@map("market_comparable_pool")
}

// ── Deal Economics & Stakeholder Waterfall Engine (spec V3.1 §29) ──────────
//
// Le patch V3.2 §1 pose FractionalProject sur un split investisseur/
// plateforme simple (PlatformFractionalProfile.incomeShareInvestorPct /
// capitalGainShareInvestorPct) — suffisant pour la majorité des dossiers.
// §29 (marqué "P0 CRITIQUE" dans la spec, ajouté après coup — absent de la
// version lue au premier passage) exige un modèle multi-stakeholder complet
// (sponsor, arrangeur, asset/property manager, prêteur...) avec waterfall à
// tiers (preferred return/return of capital/catch-up/carry/residual split)
// et taxonomie de frais versionnée. Ces 3 modèles sont OPT-IN par dossier :
// un FractionalProject sans FractionalStakeholder garde le calcul simple
// déjà en production (returns.util.ts / operating-model.util.ts,
// inchangés) — stakeholder-waterfall.util.ts n'intervient que si le
// dossier a explicitement configuré des stakeholders/tiers.
//
// Différé à P1 (cohérent avec le roadmap §28, "Mémoire" reste P1) :
// FeeAccrual/StakeholderCashFlow/StakeholderReturn/DealEconomicsSnapshot
// persistés — calculés à la volée par stakeholder-waterfall.util.ts,
// jamais stockés en P0, pour les mêmes raisons que le statut de
// sécurisation des baux (voir FractionalLease) : la source de vérité reste
// les paramètres saisis, jamais un résultat en cache.

enum StakeholderRole {
  INVESTOR
  PLATFORM
  SPONSOR
  ARRANGER
  ASSET_MANAGER
  PROPERTY_MANAGER
  LENDER
  ADVISOR
  OTHER
}

enum FeeType {
  ENTRY
  RUNNING
  TRANSACTION
  FINANCING
  EXIT
  CARRY
  REVENUE_SHARE
  CAPITAL_GAIN_SHARE
}

enum FeeCalculationBase {
  PRIX_NET_VENDEUR
  COUT_TOTAL
  GAV
  NAV
  LOYERS_BRUTS
  LOYERS_NETS
  NOI
  CAPITAL_COLLECTE
  PLUS_VALUE
  AUTRE
}

enum FeeFrequency {
  ONE_OFF
  MENSUEL
  TRIMESTRIEL
  ANNUEL
  SORTIE
}

enum WaterfallTierType {
  PREFERRED_RETURN
  RETURN_OF_CAPITAL
  CATCH_UP
  CARRIED_INTEREST
  RESIDUAL_SPLIT
}

/// Partie économique d'un deal Fractionné (spec §29.1/§29.12) — investisseurs,
/// plateforme, sponsor, arrangeur, asset/property manager, prêteur, conseils...
model FractionalStakeholder {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role  StakeholderRole
  name  String
  notes String?

  /// Capital engagé par ce stakeholder — pour INVESTOR/SPONSOR essentiellement ;
  /// laissé vide pour un stakeholder rémunéré uniquement en frais (arrangeur, conseils).
  capitalEngaged Decimal? @db.Decimal(14, 2)

  feeDefinitions FractionalFeeDefinition[]
  waterfallTiers FractionalWaterfallTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("fractional_stakeholders")
}

/// Règle de frais versionnée (spec §29.2/§29.3) — jamais codée en dur :
/// bénéficiaire, assiette, taux/montant, fréquence, bornes, source.
model FractionalFeeDefinition {
  id            String                @id @default(cuid())
  projectId     String
  project       FractionalProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderId String
  stakeholder   FractionalStakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  feeType          FeeType
  ratePct          Decimal?           @db.Decimal(6, 3)
  fixedAmount      Decimal?           @db.Decimal(14, 2)
  calculationBase  FeeCalculationBase @default(AUTRE)
  frequency        FeeFrequency       @default(ANNUEL)
  startYear        Int?
  endYear          Int?
  triggerNote      String?
  minAmount        Decimal?           @db.Decimal(14, 2)
  maxAmount        Decimal?           @db.Decimal(14, 2)
  source           String?
  confidence       String?
  scenarioBehavior String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([stakeholderId])
  @@map("fractional_fee_definitions")
}

/// Tier ordonné de la waterfall (spec §29.4) — preferred return → return of
/// capital → catch-up → carried interest → residual split, appliqué
/// annuellement par stakeholder-waterfall.util.ts dans l'ordre de `order`.
model FractionalWaterfallTier {
  id                       String                 @id @default(cuid())
  projectId                String
  project                  FractionalProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beneficiaryStakeholderId String?
  beneficiaryStakeholder   FractionalStakeholder? @relation(fields: [beneficiaryStakeholderId], references: [id], onDelete: SetNull)

  order         Int
  type          WaterfallTierType
  hurdleRatePct Decimal?          @db.Decimal(6, 3)
  catchUpPct    Decimal?          @db.Decimal(5, 2)
  sharePct      Decimal?          @db.Decimal(5, 2)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
  @@map("fractional_waterfall_tiers")
}

// ── P1 : Risque (IC Engine, Tenant Covenant) & Mémoire (Actuals/Outcome) ───
// Roadmap spec §28. Stress Testing (§18) reste un calcul pur
// (stress-testing.util.ts), rien à persister. Le Comparable Project Engine
// (§20.2) réutilise directement les FractionalProject existants — aucun
// nouveau modèle nécessaire.

enum ICDecisionStatus {
  APPROVE
  APPROVE_SUBJECT_TO_CONDITIONS
  RESTRUCTURE
  HOLD
  DECLINE
}

/// Décision IC enregistrée (spec §17/§24) — distincte de la recommandation
/// calculée à la volée par ic-engine.util.ts : un utilisateur peut
/// confirmer la recommandation telle quelle ou l'amender (statut, notes)
/// avant de l'enregistrer ici. Append-only par version, jamais réécrit.
model FractionalICDecision {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status         ICDecisionStatus
  hardStops      String[]         @default([])
  conditions     String[]         @default([])
  watchItems     String[]         @default([])
  recommendation String?
  version        Int              @default(1)

  decidedById String?
  decidedAt   DateTime @default(now())

  @@index([projectId])
  @@map("fractional_ic_decisions")
}

/// Scoring pondéré + règles éliminatoires nommées (Complément H, points 1 et
/// 8 — audit du classeur myVesta x LPB). Barème décomposable jusqu'au dernier
/// point (ScoreCategory → ScoreCriterion → ScoreBucket), partagé au niveau
/// organisation comme PlatformFractionalProfile/RentIndexSeries — jamais
/// ressaisi par dossier. assetType null = barème générique, applicable à
/// tout projet dont l'assetType ne matche aucun barème plus spécifique.
model FractionalScoreCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assetType String?
  label     String
  maxPoints Decimal @db.Decimal(6, 2)
  sortOrder Int     @default(0)

  criteria FractionalScoreCriterion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, assetType])
  @@map("fractional_score_categories")
}

/// Un critère noté au sein d'une catégorie. sourceField est indicatif
/// seulement (le champ du moteur que ce critère recoupe, pour aider la
/// saisie) — la réponse reste toujours un choix explicite dans buckets,
/// jamais une valeur recalculée automatiquement (v1, cf. H.2).
model FractionalScoreCriterion {
  id         String                  @id @default(cuid())
  categoryId String
  category   FractionalScoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  label       String
  sourceField String?
  sortOrder   Int     @default(0)

  buckets FractionalScoreBucket[]
  answers FractionalScoreAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("fractional_score_criteria")
}

/// Une tranche de réponse possible pour un critère, dans une liste fermée —
/// jamais une note libre (doctrine "jamais de score composite opaque").
model FractionalScoreBucket {
  id          String                   @id @default(cuid())
  criterionId String
  criterion   FractionalScoreCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  label         String
  points        Decimal @db.Decimal(6, 2)
  isEliminatory Boolean @default(false)
  sortOrder     Int     @default(0)

  answers FractionalScoreAnswer[]

  createdAt DateTime @default(now())

  @@index([criterionId])
  @@map("fractional_score_buckets")
}

enum FractionalScoreComparisonOperator {
  GTE
  LTE
  GT
  LT
  EQ
}

/// Règle dure indépendante du score (Complément H point 8) — peut à elle
/// seule faire basculer le verdict final en NO_GO quel que soit le score
/// pondéré. metricKey référence le registre de métriques nommées
/// d'eliminatory-rule.util.ts (jamais un champ libre/eval dynamique) ;
/// platformProfileId scope une règle propre à une plateforme (ex. seuil
/// Tantiem ≠ seuil LPB), assetType scope par typologie d'actif — les deux
/// nuls = règle globale.
model FractionalEliminatoryRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assetType         String?
  platformProfileId String?
  platformProfile   PlatformFractionalProfile? @relation(fields: [platformProfileId], references: [id], onDelete: SetNull)

  label       String
  metricKey   String
  operator    FractionalScoreComparisonOperator
  threshold   Decimal                           @db.Decimal(12, 4)
  failMessage String
  sortOrder   Int                               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, assetType])
  @@index([platformProfileId])
  @@map("fractional_eliminatory_rules")
}

enum FractionalScoreVerdict {
  NO_GO
  CONDITIONNEL
  GO
  GO_FORT
}

/// Une instance de passage au barème pour un projet donné (Complément H,
/// ScoreAssessment) — append-only par scoredAt, comme FractionalICDecision.
/// categoryBreakdown/eliminatoryResults sont le détail figé au moment du
/// calcul (jamais recalculés a posteriori si le barème change ensuite).
model FractionalScoreAssessment {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scoredById String?
  scoredAt   DateTime @default(now())

  totalPoints        Decimal                @db.Decimal(6, 2)
  maxPoints          Decimal                @db.Decimal(6, 2)
  categoryBreakdown  Json
  eliminatoryResults Json
  finalVerdict       FractionalScoreVerdict

  answers FractionalScoreAnswer[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("fractional_score_assessments")
}

model FractionalScoreAnswer {
  id           String                    @id @default(cuid())
  assessmentId String
  assessment   FractionalScoreAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    FractionalScoreCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  bucketId     String
  bucket       FractionalScoreBucket     @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
  @@index([assessmentId])
  @@map("fractional_score_answers")
}

enum ProjectOutcomeStatus {
  SUCCES
  SOUS_PERFORMANCE
  PERTE
  REFUSE
  ABANDONNE
}

/// Réalisé périodique (spec §20 "Atlas Investment Memory") — alimente
/// performance-attribution.util.ts en comparant à l'underwriting initial
/// (leases/sourcesUses/assumptionSets déjà en place, jamais dupliqués ici).
model FractionalProjectActual {
  id        String            @id @default(cuid())
  projectId String
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Texte libre ("2027", "2027-T2"...) plutôt qu'une colonne year/quarter —
  /// la granularité de suivi varie selon le dossier, pas de format imposé en P0.
  period               String
  loyersReels          Decimal? @db.Decimal(14, 2)
  occupationPct        Decimal? @db.Decimal(5, 2)
  opexReel             Decimal? @db.Decimal(14, 2)
  capexReel            Decimal? @db.Decimal(14, 2)
  distributionsReelles Decimal? @db.Decimal(14, 2)
  valorisationReelle   Decimal? @db.Decimal(14, 2)
  notes                String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("fractional_project_actuals")
}

/// Résultat final (spec §20, "y compris les dossiers refusés") — un seul par
/// dossier, enregistré à la clôture (sortie, refus ou abandon).
model FractionalProjectOutcome {
  id        String            @id @default(cuid())
  projectId String            @unique
  project   FractionalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status          ProjectOutcomeStatus
  triRealise      Decimal?             @db.Decimal(6, 3)
  multipleRealise Decimal?             @db.Decimal(6, 3)
  notes           String?

  recordedAt DateTime @default(now())

  @@map("fractional_project_outcomes")
}

// ── Préqualification (spec ATLAS "Moteur de préqualification" v1.0, socle P0) ──
//
// Sas d'analyse préparatoire avant qu'un dossier n'entre dans le Portefeuille.
// À la validation (GO / GO_SOUS_CONDITIONS), PromotionService crée un Deal
// réel (stage: SOURCING) — il n'existe PAS de table "portfolio_projects"
// séparée, Deal EST le Portefeuille (voir Deal.stage ci-dessus). Chaque champ
// métier porte sa provenance via PrequalEvidence plutôt que par colonne dédiée
// (des centaines de colonnes de provenance ne seraient pas praticables — même
// doctrine de simplification que FractionalDataProvenance, mais un modèle
// dédié : ce dernier a une FK dure vers FractionalProject et 3 axes différents
// (sourceLevel/verificationStatus/confidence), non réutilisable tel quel ici).

enum PrequalificationStatus {
  DRAFT
  NEEDS_REVIEW
  VALIDATED
  ARCHIVED
}

enum PrequalificationOrientation {
  GO
  GO_SOUS_CONDITIONS
  WAIT
  NO_GO_EN_L_ETAT
}

enum PrequalificationConfidence {
  LOW
  MEDIUM
  HIGH
}

enum PrequalificationProjectType {
  LAND_DIVISION
  PROPERTY_TRADING_NO_WORKS
  PROPERTY_TRADING_WITH_WORKS
  BUILDING_DIVISION
  RESIDENTIAL_DEVELOPMENT
  COMMERCIAL_PROPERTY
  REFINANCING
  OTHER
}

/// Racine du dossier de préqualification. `version` sert à la fois de
/// compteur de révision et de garde d'optimistic-concurrency pour la
/// commande de validation (ValidatePrequalificationCommand.expectedVersion,
/// spec §16.1) — aucun autre endroit du code ne fait ce genre de contrôle,
/// c'est un mécanisme nouveau, propre à cette commande.
model PrequalificationCase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  status      PrequalificationStatus       @default(DRAFT)
  orientation PrequalificationOrientation?
  confidence  PrequalificationConfidence?
  projectType PrequalificationProjectType?
  version     Int                          @default(1)

  entryChannel String?
  introducer   String?

  /// Ressenti qualitatif du chargé d'affaires sur le projet (Trame Prequal
  /// §6) — une appréciation personnelle assumée comme telle, distincte du
  /// commentaire de décision figé à la validation (PrequalificationVersion).
  analystImpressionNote String?

  assignedAnalystId String
  assignedAnalyst   User   @relation("PrequalAssignedAnalyst", fields: [assignedAnalystId], references: [id])

  /// Snapshot dénormalisé de la synthèse "revue en 90 secondes" (spec §3) —
  /// recalculé à chaque sauvegarde tant que le dossier n'est pas validé ;
  /// jamais recalculé après figeage d'une version (voir PrequalificationVersion).
  summary Json?

  people    PrequalPerson[]
  companies PrequalCompany[]
  project   PrequalProjectProfile?
  financial PrequalFinancialModel?
  planning  PrequalTimelineAssessment?
  lots      PrequalSalesLot[]
  documents PrequalDocument[]
  evidence  PrequalEvidence[]
  findings  Finding[]
  questions PrequalDecisiveQuestion[]
  requests  PrequalDocumentRequest[]
  versions  PrequalificationVersion[]

  createdById String
  createdBy   User   @relation("PrequalCreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  validatedAt DateTime?

  validatedById String?
  validatedBy   User?   @relation("PrequalValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  /// Posé une seule fois par PromotionService — garde-fou anti double
  /// promotion (spec §16.1 : contrainte unique côté portefeuille) en plus du
  /// contrôle applicatif de version ci-dessus. Un retry/double-clic après un
  /// premier succès doit retourner le même Deal (`alreadyPromoted: true`),
  /// jamais en créer un second.
  promotedDealId        String? @unique
  promotedDeal          Deal?   @relation(fields: [promotedDealId], references: [id])
  /// Numéro de la PrequalificationVersion figée au moment de la promotion —
  /// évite une requête de recherche du "dernier" numéro de version pour
  /// retrouver le snapshot exact utilisé lors de la décision.
  promotedVersionNumber Int?

  @@index([organizationId, status])
  @@map("prequalification_cases")
}

/// Immuable — un instantané JSON complet posé à chaque validation (spec §17 :
/// "toute évolution crée une nouvelle version et conserve l'ancienne"). Le
/// dossier Portefeuille créé à la promotion pointe vers cette version figée,
/// jamais vers l'état courant, potentiellement modifiable, de la préqual.
model PrequalificationVersion {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  versionNumber   Int
  snapshot        Json
  orientation     PrequalificationOrientation
  decisionComment String

  validatedById String
  validatedBy   User     @relation(fields: [validatedById], references: [id])
  validatedAt   DateTime @default(now())

  @@unique([prequalificationCaseId, versionNumber])
  @@map("prequalification_versions")
}

/// Statut de preuve d'une donnée (spec §4) — repris littéralement de l'enum
/// EvidenceStatus de la spec, pas de la doctrine à 3 axes de
/// FractionalDataProvenance (domaine différent, choix délibérément distinct).
enum EvidenceStatus {
  VERIFIED_OFFICIAL
  VERIFIED_DOCUMENT
  DECLARED_BY_OPERATOR
  CALCULATED_BY_ATLAS
  ANALYST_ASSESSMENT
  MISSING
  CONTRADICTORY
}

/// Provenance par champ (spec §4, SourcedValue<T>). `entityType` est une
/// chaîne libre plutôt qu'un enum fermé — même doctrine que FieldChange
/// .entityType — pour ne pas exiger de migration à chaque nouvelle sous-entité
/// tracée (aujourd'hui : PROJECT / PERSON / COMPANY / FINANCIAL / LOT).
model PrequalEvidence {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String
  fieldKey   String
  status     EvidenceStatus

  sourceDocumentId String?
  sourceDocument   PrequalDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  /// Numéro de page auto-déclaré par le modèle lors de l'extraction — une
  /// estimation, jamais une citation API vérifiée (Anthropic `citations`
  /// n'est pas câblé dans ce P0, voir document-content.util.ts). Ne jamais
  /// afficher ce champ comme une preuve certaine côté UI.
  sourcePage       Int?
  sourceUrl        String?
  confidence       Int?
  note             String?

  verifiedById String?
  verifiedBy   User?     @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prequalificationCaseId, entityType, entityId, fieldKey])
  @@index([prequalificationCaseId])
  @@map("prequalification_evidence")
}

enum PrequalPersonRole {
  PORTEUR_PRINCIPAL
  ASSOCIE
  DIRIGEANT
  GARANT
  AUTRE
}

model PrequalPerson {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  fullName String
  role     PrequalPersonRole

  cv               String?
  /// Chaque élément : { date, typology, amount, marginPct, outcome, actualRole }
  /// — jamais un simple compteur d'opérations, toujours le détail exploitable.
  trackRecord      Json[]   @default([])
  declaredNetWorth Decimal? @db.Decimal(14, 2)
  availableEquity  Decimal? @db.Decimal(14, 2)
  equityProofNote  String?
  ongoingDealsNote String?
  incidentsNote    String?

  /// Rapprochement Knowledge Graph optionnel (EntityResolutionService,
  /// type PERSON) — jamais auto-créé sans confirmation, voir doctrine
  /// resolveCompany "aucune relation créée sur la seule similarité d'un nom".
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prequalificationCaseId])
  @@map("prequalification_people")
}

enum PrequalCompanyState {
  EXISTANTE
  A_CREER
  RADIEE
  INCONNUE
}

enum PrequalCompanyRole {
  OPERATEUR
  SOCIETE_PROJET
  HOLDING
  GARANTE
  ENTREPRISE_TRAVAUX
  AUTRE
}

model PrequalCompany {
