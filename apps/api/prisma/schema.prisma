// Modèle financier v2 (P1) — aligné sur le modèle financier réel du Deal
// (FinancialAssumption / financial-model.service.ts), à la demande explicite
// de l'utilisateur qui a fourni le classeur d'audit réel (Excel) comme
// référence : Foncier / Travaux / Honoraires techniques / Autres frais /
// Financement ATLAS (équivalent LPB) / Financement bancaire optionnel /
// Ratios de couverture et de covenant / BP initial vs actualisé / Sensibilité.
// `amountRequested`/`landPrice`/`declaredMarginPct`/etc. (v1, P0) sont
// conservés tels quels ; `bankDebt`/`ratiosIncludeBankDebt` (v1, ratio "avec
// dette bancaire" au forfait) sont remplacés par le bloc "Financement
// bancaire" détaillé ci-dessous, plus riche et cohérent avec le Deal — aucune
// donnée de production n'existe encore sur ce champ (module encore en P1),
// pas de migration de compatibilité nécessaire.
model PrequalFinancialModel {
  id                     String               @id @default(cuid())
  prequalificationCaseId String               @unique
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  amountRequested         Decimal? @db.Decimal(14, 2)
  declaredEquity          Decimal? @db.Decimal(14, 2)
  provenEquity            Decimal? @db.Decimal(14, 2)
  declaredMarginPct       Decimal? @db.Decimal(6, 3)
  /// Version opérateur — pour comparaison explicite à la version ATLAS
  /// recalculée ci-dessous (spec §15, point 8 : "version opérateur, version
  /// ATLAS, écarts et sources"), jamais une simple confiance sur la marge
  /// annoncée seule.
  declaredCoutDeRevient   Decimal? @db.Decimal(14, 2)
  declaredChiffreAffaires Decimal? @db.Decimal(14, 2)
  /// Loyers/produits intermédiaires retenus pendant le portage (spec §9.2) — jamais un encaissement de stock résiduel.
  otherRevenueRetained    Decimal? @db.Decimal(14, 2)

  // Foncier
  landPrice  Decimal? @db.Decimal(14, 2) // pour le ratio LTA
  notaryFees Decimal? @db.Decimal(14, 2)

  // Honoraires techniques — 4 champs fixes (classeur d'audit réel) + postes
  // additionnels libres (PrequalCostLineItem, category HONORAIRES_TECHNIQUES).
  diagnosticsCost   Decimal? @db.Decimal(14, 2)
  insuranceCost     Decimal? @db.Decimal(14, 2)
  propertyTaxCost   Decimal? @db.Decimal(14, 2)
  surveyStudiesCost Decimal? @db.Decimal(14, 2)

  // Autres frais — hors frais de financement (calculés, jamais saisis ici)
  agencyFees   Decimal? @db.Decimal(14, 2)
  referralFees Decimal? @db.Decimal(14, 2)
  bankMiscFees Decimal? @db.Decimal(14, 2)

  // Financement ATLAS (équivalent "Modalités LPB" du classeur d'audit) — la
  // collecte réutilise amountRequested ci-dessus, pas de doublon de saisie.
  interestRatePct      Decimal? @db.Decimal(5, 2)
  durationMinMonths    Int?
  durationTargetMonths Int?
  durationMaxMonths    Int?
  feesPctHT            Decimal? @db.Decimal(5, 2)
  tvaApplicable        Boolean  @default(false)
  tvaRatePct           Decimal? @db.Decimal(5, 2)
  /// Simulation "et si le projet est en retard" : +5 points sur le taux
  /// utilisé pour les intérêts sur durée cible — jamais automatique.
  latePenaltyApplied   Boolean  @default(false)
  /// Hypothèque envisagée sur le foncier — déclenche l'estimation de frais de
  /// garantie (1,5 % de la collecte, même taux que le Deal) ; aucune vraie
  /// sûreté n'existe avant la promotion en Deal (pas de modèle Guarantee ici).
  hypothequeEnvisagee  Boolean  @default(false)
  /// Montant réellement décaissé chez le notaire à l'acte — communiqué tel
  /// quel au porteur (email de conditions, "Trame Prequal"), jamais recalculé
  /// depuis Foncier (peut différer : phasage des appels de fonds).
  montantDecaisseNotaire Decimal? @db.Decimal(14, 2)
  /// Garanties envisagées, en texte libre (hypothèque, caution personnelle,
  /// nantissement, GFA...) — pas un simple booléen, la liste réelle varie par
  /// dossier et doit apparaître telle quelle dans l'email de conditions.
  guaranteesNote         String?

  // Financement bancaire optionnel — activé dès qu'un nom de banque est renseigné
  bankName               String?
  bankLoanAcquisition    Decimal? @db.Decimal(14, 2)
  bankLoanAccompagnement Decimal? @db.Decimal(14, 2)
  bankInterestRatePct    Decimal? @db.Decimal(5, 2)
  bankFileFees           Decimal? @db.Decimal(14, 2)
  bankGuaranteeFees      Decimal? @db.Decimal(14, 2)

  // Covenants ICR/DSCR (spec ATLAS v2, module MARKO F.3) — saisie manuelle,
  // pertinence à juger au cas par cas pour du marchand de biens à cycle court.
  resultatOperationnelEstime     Decimal? @db.Decimal(14, 2)
  fluxTresorerieDisponibleEstime Decimal? @db.Decimal(14, 2)

  // Champs recalculés par prequal-financial.util.ts à chaque sauvegarde du
  // bilan — jamais saisis directement, toujours dérivés des champs/postes/lots
  // ci-dessus.
  // Sous-ensemble minimal nécessaire à prequal-rules.util.ts (findings) et à
  // la promotion vers Deal — le détail complet de la décomposition (Foncier/
  // Travaux/Honoraires/financement/ratios avec banque/sensibilité) est
  // recalculé à la volée en lecture par computePrequalFinancials() à partir
  // des champs bruts ci-dessus + costLineItems/lots, jamais dupliqué en base.
  coutDeRevient        Decimal? @db.Decimal(14, 2)
  chiffreAffaires      Decimal? @db.Decimal(14, 2)
  margeRecalculee      Decimal? @db.Decimal(14, 2)
  margeRecalculeePct   Decimal? @db.Decimal(6, 3)
  besoinMaxFinancement Decimal? @db.Decimal(14, 2)
  prixSortiePondere    Decimal? @db.Decimal(14, 2)
  pointMortAuM2        Decimal? @db.Decimal(14, 2)

  // Ratios LTA/LTC/LTV — numérateur/dénominateur toujours affichés
  // explicitement côté UI (spec §9.3), jamais un ratio nu.
  ltaPct Decimal? @db.Decimal(6, 3)
  ltcPct Decimal? @db.Decimal(6, 3)
  ltvPct Decimal? @db.Decimal(6, 3)

  // BP initial figé — même doctrine que FinancialAssumption.baselineSnapshot :
  // instantané gelé au clic sur "Figer le BP initial", tant que
  // baselineLockedAt est null aucune comparaison initial/actualisé n'est
  // affichée (évite un écart fictif dès qu'un champ encore vide est rempli).
  baselineSnapshot   Json?
  baselineLockedAt   DateTime?
  baselineLockedById String?
  baselineLockedBy   User?     @relation(fields: [baselineLockedById], references: [id], onDelete: SetNull)

  costLineItems PrequalCostLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prequalification_financial_models")
}

/// Même forme que CostLineItem (category/label/amount/sortOrder) — permet une
/// copie directe vers de vraies lignes CostLineItem à la promotion (spec §9.1).
model PrequalCostLineItem {
  id                      String                @id @default(cuid())
  prequalFinancialModelId String
  financialModel          PrequalFinancialModel @relation(fields: [prequalFinancialModelId], references: [id], onDelete: Cascade)

  category  String
  label     String
  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0)

  @@index([prequalFinancialModelId])
  @@map("prequalification_cost_line_items")
}

/// Même intention que SalesLot (spec §8) mais vocabulaire distinct de
/// SaleLot.status (chaîne libre EN_VENTE/OFFRE/.../VENDU) : l'enum ci-dessous
/// suit la spec littéralement (7 valeurs, avec not_marketed et interest qui
/// n'ont pas d'équivalent dans SaleLot) — la promotion vers SaleLot applique
/// un mapping explicite documenté dans promotion.service.ts, pas une
/// coïncidence de nommage à ne pas supposer identique.
enum PrequalLotStatus {
  NOT_MARKETED
  MARKETED
  INTEREST
  OFFER
  RESERVATION
  PROMISE
  DEED
}

model PrequalSalesLot {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  label                String
  assetType            String?
  surfaceSqm           Decimal?         @db.Decimal(10, 2)
  askingPrice          Decimal?         @db.Decimal(14, 2)
  expectedPrice        Decimal?         @db.Decimal(14, 2)
  status               PrequalLotStatus @default(NOT_MARKETED)
  conditionsPrecedent  String[]         @default([])
  buyerFinancingStatus String?
  sortOrder            Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prequalificationCaseId])
  @@map("prequalification_sales_lots")
}

model PrequalTimelineAssessment {
  id                     String               @id @default(cuid())
  prequalificationCaseId String               @unique
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  businessUrgencyNote String?
  realisticTimeline   String?
  /// [{ label, note }]
  dependencies        Json[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prequalification_timeline_assessments")
}

model PrequalDocument {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  name           String
  mimeType       String
  size           Int
  storageKey     String
  storageDriver  String  @default("local")
  classification String?
  pageCount      Int?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  evidence PrequalEvidence[]

  createdAt              DateTime                 @default(now())
  PrequalDocumentRequest PrequalDocumentRequest[]

  @@index([prequalificationCaseId])
  @@map("prequalification_documents")
}

enum FindingCategory {
  OPERATOR
  COMPANY
  FINANCIAL
  MARKET
  PLANNING
  COMMERCIALISATION
  WORKS
  LEGAL
  EXPOSURE
}

enum FindingSeverity {
  INFO
  POSITIVE
  WATCH
  MATERIAL
  BLOCKING
}

enum FindingGeneratedBy {
  RULE
  MODEL
  ANALYST
}

enum FindingReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  AMENDED
}

/// Une orientation GO n'est jamais délivrée s'il subsiste un Finding
/// BLOCKING dont reviewStatus est PENDING ou ACCEPTED (voir
/// promotion.service.ts) — REJECTED/AMENDED signifie que l'analyste a
/// explicitement statué sur le point, GO redevient possible.
model Finding {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  category    FindingCategory
  severity    FindingSeverity
  statement   String
  rationale   String
  evidenceIds String[]           @default([])
  ruleId      String?
  generatedBy FindingGeneratedBy

  reviewStatus FindingReviewStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([prequalificationCaseId, severity])
  @@map("prequalification_findings")
}

model PrequalDecisiveQuestion {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  question                     String
  reason                       String
  affectedFindingIds           String[] @default([])
  answerCouldChangeOrientation Boolean
  /// 'blocking' | 'decisive' | 'instruction' | 'comfort' — chaîne libre
  /// validée côté DTO (@IsIn), même doctrine que SaleLot.status.
  priority                     String

  answer     String?
  answeredAt DateTime?

  createdAt DateTime @default(now())

  @@index([prequalificationCaseId])
  @@map("prequalification_decisive_questions")
}

model PrequalDocumentRequest {
  id                     String               @id @default(cuid())
  prequalificationCaseId String
  case                   PrequalificationCase @relation(fields: [prequalificationCaseId], references: [id], onDelete: Cascade)

  label  String
  /// identite/travaux/urbanisme/division/parcellaire/commercialisation/
  /// acquisition_conditionnelle/revenus_locatifs/autres_plateformes
  block  String
  /// requested/received/expired/contradictory/not_usable — chaîne libre validée côté DTO.
  status String @default("requested")

  linkedDocumentId String?
  linkedDocument   PrequalDocument? @relation(fields: [linkedDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prequalificationCaseId])
  @@map("prequalification_document_requests")
}

/// Jalon bloquant du Portefeuille (spec §16.1, "chaque réserve décisive
/// devient un portfolio_milestone bloquant") — distinct de ProjectCheckpoint,
/// qui suit l'avancement travaux/commercialisation en cours de vie du deal,
/// pas des conditions de sortie de SOURCING.
model PortfolioMilestone {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  label       String
  description String?
  blocking    Boolean @default(true)
  status      String  @default("PENDING") // PENDING/RESOLVED/WAIVED — chaîne libre validée côté DTO

  /// Traçabilité vers le Finding d'origine, quand le jalon vient d'une
  /// condition de préqualification plutôt que d'un ajout manuel ultérieur.
  sourceFindingId String?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([dealId])
  @@map("portfolio_milestones")
}
