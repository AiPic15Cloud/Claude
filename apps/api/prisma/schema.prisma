// ATLAS — Real Estate Intelligence Operating System
// Prisma schema — foundation, Cockpit, Portefeuille, Dossiers, Score ATLAS,
// Knowledge Graph, Cartographie, Intelligence Concurrentielle and
// Intelligence Marché domain models. AI agents (module 9) read this data
// but do not require schema of their own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum DealType {
  PROMOTION_IMMOBILIERE
  DIVISION_PARCELLAIRE
  DIVISION_FONCIERE
  MISE_EN_COPROPRIETE
  AMENAGEMENT_FONCIER
  MARCHAND_DE_BIENS_AVEC_TRAVAUX
  MARCHAND_DE_BIENS_SANS_TRAVAUX
  REFINANCEMENT_FONDS_PROPRES
  REFINANCEMENT_ACTIF
  REFINANCEMENT_STOCK
}

/// Pipeline stage — drives the Kanban view in the Portefeuille module.
enum DealStage {
  SOURCING
  ANALYSE
  COMITE
  MONTAGE
  COLLECTE
  FINANCE
  SUIVI
  REMBOURSE
  DEFAUT
}

enum DealStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommitteeStatus {
  PAS_DE_COMITE
  VALIDE
  CONDITIONS_SUSPENSIVES
  REFUSE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ActivityType {
  DEAL_CREATED
  DEAL_UPDATED
  STAGE_CHANGED
  RECOVERY_STATUS_CHANGED
  NOTE_ADDED
  DOCUMENT_ADDED
  TASK_CREATED
  TASK_COMPLETED
  TAG_ADDED
  TAG_REMOVED
  GUARANTEE_ADDED
  FINANCIAL_MODEL_UPDATED
  ENTITY_LINKED
  CHECKPOINT_CREATED
}

enum GuaranteeType {
  HYPOTHEQUE
  FIDUCIE
  CAUTION
  GAGE
  NANTISSEMENT
  PRIVILEGE
  AUTRE
}

// Sain → aucun signal ; En retard → échéance dépassée sans réaction du
// porteur ; Pré-contentieux → mise en demeure envoyée mais pas encore de
// procédure ; Procédure → action judiciaire engagée. Remplace l'ancien
// booléen `contentieux` (trop grossier : il confondait pré-contentieux et
// procédure) — renseigné manuellement, aucune règle ne peut fiablement
// déduire ce jugement depuis les autres champs.
enum DealRecoveryStatus {
  SAIN
  EN_RETARD
  PRE_CONTENTIEUX
  PROCEDURE
}

enum GuaranteeStatus {
  ACTIVE
  RELEASED
  DEFAULTED
}

/// Knowledge Graph node types — every entity the graph connects together.
enum GraphEntityType {
  PROMOTEUR
  BANQUE
  NOTAIRE
  ARCHITECTE
  COLLECTIVITE
  INVESTISSEUR
  PLATEFORME
}

/// The role a Knowledge Graph entity plays on a specific deal.
enum DealEntityRole {
  PROMOTEUR
  BANQUE_FINANCEUR
  NOTAIRE
  ARCHITECTE
  COLLECTIVITE
  INVESTISSEUR
  GARANT
  AUTRE
}

enum GraphRelationType {
  PARTENAIRE
  FINANCEUR
  CONSEIL
  CONCURRENT
  AUTRE
}

enum ArticleCategory {
  TAUX
  INFLATION
  CONSTRUCTION
  IMMOBILIER
  LOGISTIQUE
  COMMERCE
  RESIDENTIEL
  REGLEMENTATION
  CONCURRENCE
  AUTRE
}

// ── Core tenancy ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  deals              Deal[]
  tags               Tag[]
  alerts             Alert[]
  graphEntities      GraphEntity[]
  graphRelations     GraphRelation[]
  newsSources        NewsSource[]
  articles           Article[]
  feesTargets        FeesTarget[]
  pipelineEntries    PipelineEntry[]
  competitorProjects CompetitorProject[]
  tasks              Task[]
  fieldChanges       FieldChange[]
  dataValidations    DataValidation[]

  @@map("organizations")
}

// One row per year — the "objectif annuel" the Cockpit fees chart is
// measured against.
model FeesTarget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year         Int
  targetAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year])
  @@map("fees_targets")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(ANALYST)
  avatarUrl      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  createdDeals               Deal[]              @relation("DealCreatedBy")
  assignedDeals              Deal[]              @relation("DealAssignedTo")
  notes                      Note[]
  documents                  Document[]
  repayments                 Repayment[]
  pipelineEntries            PipelineEntry[]
  tasksAssigned              Task[]              @relation("TaskAssignee")
  tasksCreated               Task[]              @relation("TaskCreatedBy")
  activities                 Activity[]
  refreshTokens              RefreshToken[]
  competitorProjectsLogged   CompetitorProject[]
  projectCheckpointsRecorded ProjectCheckpoint[]
  agentMessages              AgentMessage[]
  pushSubscriptions          PushSubscription[]
  fieldChanges               FieldChange[]
  dataValidations            DataValidation[]
  financialAssumptionsLocked FinancialAssumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

/// One row per browser/device that opted into push notifications — a user
/// can have several (phone, laptop). Deleted on unsubscribe, or pruned by
/// PushService when the push endpoint reports it's gone (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Portfolio domain ───────────────────────────────────────

// Backs atomic reference-number generation (ATL-YYYY-NNNN). A read-then-
// increment in application code races under concurrent creates — two
// requests can read the same "last" value before either commits, then
// both retry from that same stale reading. A single atomic SQL upsert
// against this counter closes that race entirely, regardless of load.
model ReferenceCounter {
  organizationId String
  year           Int
  value          Int

  @@id([organizationId, year])
  @@map("reference_counters")
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference   String     @unique
  name        String
  type        DealType
  stage       DealStage  @default(SOURCING)
  status      DealStatus @default(ACTIVE)
  description String?

  // Financials
  amountTarget   Decimal  @db.Decimal(14, 2)
  amountRaised   Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("EUR")
  interestRate   Decimal? @db.Decimal(5, 2)
  durationMonths Int?

  // Fees — feesRate is the input (%), feesAmount is always server-derived
  // from feesRate × amountRaised, never accepted directly from a client.
  feesRate   Decimal? @db.Decimal(5, 2)
  feesAmount Decimal  @default(0) @db.Decimal(14, 2)

  // Location
  address  String?
  city     String?
  postcode String?
  country  String   @default("FR")
  lat      Decimal? @db.Decimal(9, 6)
  lng      Decimal? @db.Decimal(9, 6)

  // Scoring
  atlasScore Int? @default(0)

  // Risk Engine — score de risque dynamique (0 = aucun risque, 100 = risque
  // maximal), recalculé à chaque événement pertinent (checkpoint, garantie,
  // recouvrement, échéance, surveillance société) plutôt que sur un simple
  // timer. riskScorePrevious ne garde que la valeur d'avant le dernier
  // recalcul (pas un historique complet) — suffisant pour la flèche de
  // tendance par dossier, mais ne peut pas honnêtement porter un delta
  // "cette semaine" au niveau portefeuille une fois les recalculs
  // événementiels multiples par jour ; une vraie table de snapshots
  // horodatés serait nécessaire pour ça, en suivi séparé si besoin.
  riskScore          Int?
  riskScorePrevious  Int?
  riskScoreUpdatedAt DateTime?

  // Dernier score connu juste avant la clôture du dossier (repaid ou
  // DEFAUT) — capturé une seule fois, jamais réécrit ensuite. Sert de base
  // 100% réelle à la validation rétrospective du modèle (RiskEngineService
  // .getModelValidation()) : rapprocher ce score du résultat effectif
  // (remboursé vs défaut) plutôt que de calibrer les pondérations sans
  // historique suffisant.
  riskScoreAtClosure     Int?
  riskScoreAtClosureDate DateTime?

  startDate DateTime?
  endDate   DateTime?

  // Deadline tracking (échéance de vote) — dateMax drives the J-90/J-60/J-30/J-15
  // escalation process; dateMin/dateCible are informational targets either
  // side of it.
  dateMin   DateTime?
  dateCible DateTime?
  dateMax   DateTime?

  // repaid suppresses deadline-alert escalation entirely (a fully repaid
  // deal shouldn't keep raising "échéance dépassée" once it's settled).
  // recoveryStatus is an independent manual field — a deal can be repaid or
  // active while also being flagged as in (pre-)litigation.
  repaid         Boolean            @default(false)
  recoveryStatus DealRecoveryStatus @default(SAIN)

  // Investor newsletter follow-up — lastNewsletterDate resets the countdown;
  // status (À jour / À relancer / Critique) is derived from the elapsed days
  // vs. newsletterTargetDays, not stored.
  lastNewsletterDate   DateTime?
  newsletterTargetDays Int       @default(45)

  // Porteur de projet (recipient of relance/mise en demeure correspondence)
  // — distinct from the property's own address above, which is the asset's
  // location, not the operator's contact details.
  porteurNom     String?
  porteurSociete String?
  porteurAdresse String?

  // Surveillance de la société de projet — SIREN suivi quotidiennement via
  // l'API Recherche d'Entreprises (data.gouv.fr) pour détecter une procédure
  // collective ou une cessation d'activité. porteurMonitoringStatus est le
  // dernier statut connu ('actif' / 'procedure_collective' / 'fermee'),
  // comparé à chaque vérification pour n'alerter que sur un vrai changement
  // plutôt qu'à chaque exécution du job.
  porteurSiren            String?
  porteurMonitoringStatus String?

  createdById  String
  createdBy    User    @relation("DealCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("DealAssignedTo", fields: [assignedToId], references: [id])

  tags                       DealTag[]
  notes                      Note[]
  documents                  Document[]
  tasks                      Task[]
  activities                 Activity[]
  alerts                     Alert[]
  guarantees                 Guarantee[]
  costLineItems              CostLineItem[]
  saleLots                   SaleLot[]
  financialAssumption        FinancialAssumption?
  entityLinks                DealEntityLink[]
  repayments                 Repayment[]
  convertedFromPipelineEntry PipelineEntry?       @relation("PipelineConvertedDeal")
  checkpoints                ProjectCheckpoint[]
  agentMessages              AgentMessage[]
  fieldChanges               FieldChange[]
  dataValidations            DataValidation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([stage])
  @@index([type])
  @@index([status])
  @@map("deals")
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#6366f1")

  deals DealTag[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@map("tags")
}

model DealTag {
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

// A sourcing-stage entry — a deal file received and reviewed, before (or
// instead of) becoming an actual Deal. Distinct from Deal because most
// entries here are rejected and never enter the managed portfolio.
model PipelineEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date      DateTime
  operator  String
  typology  String?
  source    String?
  amount    Decimal         @db.Decimal(14, 2)
  margin    Decimal?        @db.Decimal(5, 2)
  // ATLAS's own fee rate (%) negotiated on this dossier — distinct from
  // `margin`, which is the underlying deal's profitability. Feeds the fees
  // projection (below) per-dossier instead of falling back to the
  // portfolio-wide average feesRate for every pipeline entry alike.
  feesRate  Decimal?        @db.Decimal(5, 2)
  committee CommitteeStatus @default(PAS_DE_COMITE)
  decision  String?

  // Set once this dossier has actually been turned into a live operation —
  // the one-way link that lets the pipeline's conversion KPIs (and the fees
  // projection) be grounded in real portfolio deals instead of guesswork.
  convertedDealId String? @unique
  convertedDeal   Deal?   @relation("PipelineConvertedDeal", fields: [convertedDealId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([committee])
  @@map("pipeline_entries")
}

// A repayment made to investors on a deal — either already paid (projected:
// false) or a forward-looking estimate (projected: true) used for the
// Cockpit's repayment forecast.
model Repayment {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  projected Boolean  @default(false)
  note      String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("repayments")
}

model Note {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId String
  author   User        @relation(fields: [authorId], references: [id])
  content  String
  images   NoteImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("notes")
}

model NoteImage {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  mimeType      String
  storageKey    String
  storageDriver String @default("local")

  createdAt DateTime @default(now())

  @@index([noteId])
  @@map("note_images")
}

// État des lieux fait à la durée cible (et éventuellement au-delà, si le
// dossier reste sous surveillance rapprochée) — un chargé d'affaires
// enregistre un point à la fois, jamais modifié après coup, pour garder
// l'historique des points successifs sur un même dossier plutôt qu'un
// unique état toujours écrasé.
model ProjectCheckpoint {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  travauxBudgetInitial Decimal? @db.Decimal(14, 2)
  travauxDepensesADate Decimal? @db.Decimal(14, 2)
  travauxTermines      Boolean  @default(false)

  commercialisationLancee Boolean  @default(false)
  pourcentageVendu        Int?
  prixVenteInitialPrevu   Decimal? @db.Decimal(14, 2)
  prixVenteReelADate      Decimal? @db.Decimal(14, 2)

  atterrissagePrevu String?
  notes             String?

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("project_checkpoints")
}

// One row per turn of an Assistant IA conversation on a deal — including the
// Devil's Advocate replies (agentKey "devil"), so both the agents' analyses
// and the contradictory review survive navigation/reload instead of living
// only in the browser tab's React state, and keep feeding the dossier's
// analysis over time instead of being re-derived from scratch each session.
model AgentMessage {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Which agent persona produced (or received, for a user turn) this
  /// message — e.g. "analyst", "legal", "devil".
  agentKey String
  role     String
  content  String @db.Text

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("agent_messages")
}

model Document {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  name          String
  mimeType      String
  size          Int
  storageKey    String
  storageDriver String @default("local")

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fieldChanges FieldChange[]

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("documents")
}

// Journal d'audit générique par champ — distinct d'Activity (fil narratif
// lisible) : ici, chaque ligne est une valeur structurée avant/après,
// interrogeable par champ, pour la gouvernance de la donnée (qui a changé
// quoi, quand, et avec quel document à l'appui). entityType est une chaîne
// libre plutôt qu'un enum pour ne pas exiger de migration à chaque nouvelle
// surface auditée (aujourd'hui : 'Deal', 'FinancialAssumption').
model FieldChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  entityType String
  fieldKey   String
  fieldLabel String

  /// Stringifié pour affichage ; null = première valeur jamais renseignée.
  oldValue String?
  newValue String?

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  sourceDocumentId String?
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  @@index([organizationId])
  @@index([dealId, entityType])
  @@map("field_changes")
}

// Sign-off d'une seule personne (pas un maker-checker à deux) : atteste que
// l'état actuel d'une entité sur ce dossier a été relu et confirmé, avec
// horodatage. Une ligne = "validé, rien n'a changé depuis" — dès qu'un
// nouveau FieldChange est écrit pour ce (dealId, entityType), la ligne est
// supprimée (FieldChangeService.recordDiff) pour que "validé" ne mente
// jamais sur l'état réel.
model DataValidation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  entityType String // même convention que FieldChange.entityType

  validatedById String
  validatedBy   User     @relation(fields: [validatedById], references: [id], onDelete: Cascade)
  validatedAt   DateTime @default(now())

  @@unique([dealId, entityType])
  @@map("data_validations")
}

model Task {
  id     String  @id @default(cuid())
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Set directly at creation (not derived from `deal`) so deal-less tasks
  /// still carry a real tenant boundary — every query filters on this
  /// column, never on "no deal means no scope" fallbacks.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title    String
  done     Boolean   @default(false)
  priority Priority  @default(MEDIUM)
  dueDate  DateTime?

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([dealId])
  @@index([organizationId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Activity {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    ActivityType
  message String

  createdAt DateTime @default(now())

  @@index([dealId])
  @@map("activities")
}

model Alert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  articleId      String?
  article        Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)

  severity AlertSeverity @default(INFO)
  title    String
  message  String
  read     Boolean       @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([read])
  @@map("alerts")
}

// ── Dossiers: guarantees & financial model ────────────────

model Guarantee {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type        GuaranteeType
  description String
  amount      Decimal         @db.Decimal(14, 2)
  rank        Int             @default(1)
  status      GuaranteeStatus @default(ACTIVE)

  // Applies to HYPOTHEQUE / FIDUCIE / CAUTION — other guarantee types don't
  // carry a renewal deadline. Drives both the "Valide / Non valide" state
  // (computed, not stored — see guarantee-expiry.util.ts) and the 6-month
  // renewal warning/notification.
  endDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("guarantees")
}

/// Inputs for the deal's financial model. Sensitivity scenarios (± on
/// selling price and construction cost) are computed on the fly from these
/// assumptions rather than stored, so they always reflect the latest input.
// Modèle financier v2 (Phase 1) — reconstruit à partir du classeur d'audit
// réel de l'utilisateur (Foncier / Travaux / Honoraires techniques / Autres
// frais / Financement LPB / Financement bancaire), plutôt que le triptyque
// surface×coût/m²×prix/m² d'origine. Les postes "Travaux" sont libres (voir
// CostLineItem) — confirmé par l'utilisateur, pas des champs fixes.
model FinancialAssumption {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  surfaceSqm         Decimal  @db.Decimal(10, 2)
  sellingPricePerSqm Decimal  @db.Decimal(10, 2)
  targetMarginPct    Decimal? @db.Decimal(5, 2)
  notes              String?

  // Foncier
  landPrice  Decimal? @db.Decimal(14, 2)
  notaryFees Decimal? @db.Decimal(14, 2)

  // Honoraires techniques — structure fixe (confirmée telle quelle dans le classeur d'audit)
  diagnosticsCost   Decimal? @db.Decimal(14, 2)
  insuranceCost     Decimal? @db.Decimal(14, 2)
  propertyTaxCost   Decimal? @db.Decimal(14, 2)
  surveyStudiesCost Decimal? @db.Decimal(14, 2)

  // Autres frais — les frais LPB (garantie/intérêts/fees) sont calculés, jamais saisis ici.
  // agencyFees et referralFees sont deux commissions distinctes (agence immobilière vs
  // apporteur d'affaires) — toutes deux à 0 par défaut si aucun frais.
  agencyFees   Decimal? @db.Decimal(14, 2)
  referralFees Decimal? @db.Decimal(14, 2)
  bankMiscFees Decimal? @db.Decimal(14, 2)

  // Financement LPB — la collecte/le taux/la durée cible réutilisent
  // Deal.amountTarget/interestRate/durationMonths, pas de doublon de saisie.
  lpbFeesPctHT         Decimal? @db.Decimal(5, 2)
  lpbTvaApplicable     Boolean  @default(false)
  lpbTvaRatePct        Decimal? @db.Decimal(5, 2)
  lpbDurationMinMonths Int?
  lpbDurationMaxMonths Int?
  // Simulation "et si le projet est en retard" : +5 points sur le taux LPB
  // utilisé pour calculer les intérêts sur durée cible — sert à mesurer
  // l'impact financier réel d'un dépassement plutôt qu'à documenter un fait.
  latePenaltyApplied Boolean @default(false)

  // Financement bancaire (optionnel, distinct de LPB) — activé dès qu'un nom de banque est renseigné
  bankName               String?
  bankLoanAcquisition    Decimal? @db.Decimal(14, 2)
  bankLoanAccompagnement Decimal? @db.Decimal(14, 2)
  bankInterestRatePct    Decimal? @db.Decimal(5, 2)
  bankFileFees           Decimal? @db.Decimal(14, 2)
  bankGuaranteeFees      Decimal? @db.Decimal(14, 2)

  // BP initial figé — copie gelée des totaux calculés (Foncier, Travaux,
  // Honoraires, financement, marge, sensibilité) au moment où l'utilisateur
  // clique "Figer le BP initial", une fois sa saisie terminée. Tant que
  // baselineLockedAt est null, aucune comparaison initial/actualisé n'est
  // affichée — évite qu'un champ encore vide en cours de saisie (donc à sa
  // valeur par défaut) soit pris à tort pour le "point de départ" réel.
  baselineSnapshot   Json?
  baselineLockedAt   DateTime?
  baselineLockedById String?
  baselineLockedBy   User?     @relation(fields: [baselineLockedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("financial_assumptions")
}

// Postes de coût libres — aujourd'hui uniquement les "Travaux" (l'utilisateur
// les saisit ligne par ligne dans son classeur réel, pas via des champs
// fixes). `category` prévoit l'extension à d'autres postes plus tard, non
// exploitée pour l'instant.
model CostLineItem {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  category  String
  label     String
  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, category])
  @@map("cost_line_items")
}

/// Grille de commercialisation lot par lot — remplace le prix de vente moyen
/// (sellingPricePerSqm × surfaceSqm) par la somme des prix réels/prévisionnels
/// de chaque lot dès qu'au moins un lot est saisi (FinancialModelService).
/// Un prix moyen peut masquer qu'un projet n'est viable que si certains lots
/// se vendent au-dessus du marché — la grille rend ce risque visible.
model SaleLot {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  label      String
  surfaceSqm Decimal @db.Decimal(10, 2)
  salePrice  Decimal @db.Decimal(14, 2)
  // Statut de commercialisation du lot — string libre (pas un enum Prisma)
  // pour rester cohérent avec CostLineItem.category : validé côté DTO
  // (@IsIn), pas de migration nécessaire si un statut s'ajoute plus tard.
  // Valeurs : EN_VENTE | OFFRE | PROMESSE_COMPROMIS | RESERVATION | VENDU
  status     String  @default("EN_VENTE")
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("sale_lots")
}

// ── Knowledge Graph ────────────────────────────────────────

/// A node in the Knowledge Graph: promoteur, banque, notaire, architecte,
/// collectivité, investisseur or plateforme. Type-specific attributes
/// (e.g. a platform's category or founding year) live in `metadata`.
model GraphEntity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type        GraphEntityType
  name        String
  description String?
  website     String?
  city        String?
  /// City-centroid coordinates (not street-level) — used by the Cartographie module.
  lat         Decimal?        @db.Decimal(9, 6)
  lng         Decimal?        @db.Decimal(9, 6)
  metadata    Json?

  /// Person to contact at this entity (e.g. the porteur de projet themselves,
  /// or the relationship manager at a bank/notaire) — distinct from `name`,
  /// which is the organization/company name.
  contactName String?
  email       String?
  phone       String?

  dealLinks          DealEntityLink[]
  relationsFrom      GraphRelation[]     @relation("RelationFrom")
  relationsTo        GraphRelation[]     @relation("RelationTo")
  articles           ArticleEntityLink[]
  competitorProjects CompetitorProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@map("graph_entities")
}

/// Links a deal to a Knowledge Graph entity with a specific role
/// (e.g. this deal's promoteur, or its notaire).
model DealEntityLink {
  id       String         @id @default(cuid())
  dealId   String
  deal     Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  entityId String
  entity   GraphEntity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role     DealEntityRole

  createdAt DateTime @default(now())

  @@unique([dealId, entityId, role])
  @@index([entityId])
  @@map("deal_entity_links")
}

/// An edge between two Knowledge Graph entities (e.g. a promoteur partnered
/// with a bank, or two platforms are direct competitors).
model GraphRelation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fromEntityId String
  fromEntity   GraphEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId   String
  toEntity     GraphEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  type  GraphRelationType
  label String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("graph_relations")
}

enum CompetitorProjectStatus {
  A_VENIR
  EN_COLLECTE
  CLOTURE
}

/// Manually logged by an analyst against a competitor PLATEFORME entity —
/// there's no automated feed for a competitor's live/upcoming project
/// listing (their "app" is behind a login, and scraping an authenticated
/// competitor account is out of scope), so this is deliberately a fast,
/// low-friction manual log rather than a sync target.
model CompetitorProject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityId       String
  entity         GraphEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name         String
  status       CompetitorProjectStatus @default(EN_COLLECTE)
  targetAmount Decimal?                @db.Decimal(14, 2)
  expectedDate DateTime?
  url          String?
  note         String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([entityId])
  @@map("competitor_projects")
}

// ── Intelligence Marché: news pipeline ─────────────────────

/// A configured source for the market-intelligence pipeline. `connector`
/// names the ingestion strategy — a registered code connector (e.g.
/// "data-gouv-dvf") or "manual" for analyst-entered items.
model NewsSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  connector     String
  url           String?
  active        Boolean   @default(true)
  lastFetchedAt DateTime?

  articles Article[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@map("news_sources")
}

model Article {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceId       String
  source         NewsSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String
  summary     String?
  url         String?
  category    ArticleCategory @default(AUTRE)
  publishedAt DateTime
  /// Hash of title+url used to deduplicate re-fetched items across runs.
  dedupeHash  String          @unique
  priority    Priority        @default(MEDIUM)

  entities ArticleEntityLink[]
  alerts   Alert[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([category])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleEntityLink {
  id        String      @id @default(cuid())
  articleId String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entityId  String
  entity    GraphEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([articleId, entityId])
  @@map("article_entity_links")
}
