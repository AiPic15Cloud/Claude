{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @atlas/api prisma:generate && pnpm --filter @atlas/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @atlas/api prisma:deploy && pnpm --filter @atlas/api start",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
